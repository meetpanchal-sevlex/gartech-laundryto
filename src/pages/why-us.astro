---
import Layout from '../layouts/Layout.astro';
const pillars = [
  { num: "01", title: "Legacy of Trust Since 1998", desc: "Over 25 years of specialized experience manufacturing commercial laundry equipment tailored precisely to Indian water hardness and voltage conditions." },
  { num: "02", title: "AISI 304 Heavy-Duty Build", desc: "Every wash cylinder, shaft, and casing is fabricated with certified grade 304 stainless steel, heavy spherical roller bearings, and Viton seals." },
  { num: "03", title: "Pan-India Logistics & Service", desc: "Strategic service depots across Gujarat, Maharashtra, Delhi NCR, Karnataka, Tamil Nadu, and Telangana with guaranteed 24-48 hr engineer dispatch." },
  { num: "04", title: "10,000+ Ready Spares in Stock", desc: "We maintain an exhaustive warehouse of genuine inverters, motors, heating elements, drain valves, and door gaskets for same-day dispatch." },
  { num: "05", title: "Turnkey CAD Utility Planning", desc: "From civil foundation drawings to steam pipe sizing, compressed air routing, and electrical MCC panels, we deliver full CAD layouts." },
  { num: "06", title: "ISO 9001:2015 Quality Tested", desc: "Every machine undergoes a rigorous 72-hour continuous wet test cycle at our Gujarat plant before dispatch, ensuring vibration-free balance." }
];
---
<Layout title="Why Choose Gartech Global | Industrial Laundry Partner" description="Why Indian hotels, hospitals, and laundromats choose Gartech Global: 25+ years legacy, AISI 304 construction, 10,000+ ready spares, and pan-India service.">

  <!-- DARK HERO -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 industrial-grid-dark">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <span class="text-blue-400">WHY GARTECH GLOBAL</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
        The Engineering Benchmark
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4">Why Choose Gartech Global?</h1>
      <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed">
        Engineered for nonstop heavy duty, immediate spares fulfillment, and zero plant downtime.
      </p>
    </div>
  </section>

  <!-- 6 PILLARS -->
  <section class="w-full py-16 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {pillars.map((p) => (
          <div class="p-7 rounded-2xl bg-white border-t-4 border-t-blue-600 border-x border-b border-neutral-200 shadow-md hover:shadow-xl transition-all">
            <div class="w-10 h-10 rounded-xl bg-zinc-950 text-white flex items-center justify-center font-bold font-mono text-sm mb-4">{p.num}</div>
            <h2 class="text-lg font-extrabold text-zinc-950 mb-2">{p.title}</h2>
            <p class="text-neutral-600 text-sm leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-zinc-950 text-white px-4 sm:px-6 lg:px-8 py-16 text-center industrial-grid-dark">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black mb-3">Ready to Partner with Gartech Global?</h2>
      <p class="text-neutral-400 text-sm mb-6">Tell us your laundry requirement and our engineering team will respond within 24 hours.</p>
      <a href="/contact" class="inline-block px-8 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request a Quote</a>
    </div>
  </section>

</Layout>
