---
import Layout from '../layouts/Layout.astro';
const steps = [
  { num: "01", title: "Volume & Linen Audit", desc: "We calculate your exact daily KG processing load, peak occupancy surges, and shift duration." },
  { num: "02", title: "Equipment Sizing Matrix", desc: "Balanced washer-to-dryer ratios (typically 1:1.25) plus flatwork and pressing throughput matching." },
  { num: "03", title: "CAD Utility Blueprints", desc: "Detailed architectural drawings for steam headers, compressed air, 3-phase MCC panels, and floor drains." },
  { num: "04", title: "Turnkey Commissioning", desc: "Factory dispatch from Gujarat, rigging, 72-hour wet testing, and on-site staff training." }
];
---
<Layout title="Turnkey Commercial Laundry Setup & CAD Planning | Gartech Global" description="Complete turnkey commercial laundry setup consulting: capacity sizing, CAD utility drawings, equipment supply, and commissioning across India.">

  <!-- DARK HERO -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 industrial-grid-dark">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <span class="text-emerald-400">TURNKEY LAUNDRY SETUP</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        End-to-End Facility Engineering
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4">Turnkey Commercial Laundry Setup</h1>
      <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed mb-8">
        Building a new hotel laundry, hospital central plant, or commercial laundromat? Gartech handles everything from CAD utility blueprints to final wet commissioning.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact?category=setup" class="px-7 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request Turnkey Feasibility</a>
        <a href="/price-list" class="px-7 py-3.5 text-sm font-semibold text-white bg-white/10 border border-white/15 rounded-full hover:bg-white/15 transition-all">View Equipment Pricing</a>
      </div>
    </div>
  </section>

  <!-- 4-STEP SETUP WORKFLOW -->
  <section class="w-full py-16 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((st) => (
          <div class="bg-white rounded-2xl border-t-4 border-t-emerald-600 border-x border-b border-neutral-200 p-7 shadow-md">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-zinc-950 text-white font-mono font-bold text-sm mb-4">{st.num}</span>
            <h2 class="text-lg font-black text-zinc-950 mb-2">{st.title}</h2>
            <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">{st.desc}</p>
          </div>
        ))}
      </div>

      <!-- Utility Checklist Box -->
      <div class="bg-white rounded-2xl border-2 border-neutral-300 p-8 shadow-lg grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 font-mono text-xs font-bold border border-blue-200">ARCHITECTURAL SUPPORT</span>
          <h3 class="text-2xl font-black text-zinc-950 mt-3 mb-3">What Our Engineering Drawings Cover</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">We coordinate directly with your MEP consultants and architects before civil work begins—preventing costly re-piping or drainage mistakes.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono font-semibold text-zinc-800">
          <div class="p-3.5 rounded-xl bg-neutral-100 border border-neutral-200">&bull; 3-Phase Electrical Load &amp; MCB</div>
          <div class="p-3.5 rounded-xl bg-neutral-100 border border-neutral-200">&bull; Steam Header &amp; Condensate Trap</div>
          <div class="p-3.5 rounded-xl bg-neutral-100 border border-neutral-200">&bull; Cold/Hot Water Pressure Sizing</div>
          <div class="p-3.5 rounded-xl bg-neutral-100 border border-neutral-200">&bull; Floor Drain Trench &amp; Exhaust Duct</div>
        </div>
      </div>

    </div>
  </section>

</Layout>
