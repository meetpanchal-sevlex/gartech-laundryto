---
import Layout from '../layouts/Layout.astro';
import LifecycleShowcase from '../components/LifecycleShowcase.astro';
---

<Layout title="Service, Spares & Pan-India Support | Gartech Global" description="Gartech Global provides pan-India installation, commissioning, preventive maintenance, and genuine spare parts support across the complete machinery lifecycle.">

  <!-- DARK HERO -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 industrial-grid-dark">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <span class="text-blue-400">SERVICE &amp; SPARES SUPPORT</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        24-48 Hr Pan-India Technician Dispatch
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white mb-4">
        Support Beyond the Sale
      </h1>
      <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed">
        Industrial machinery requires precision at every stage. We engineer a complete operational lifecycle backed by 10,000+ genuine spares in stock.
      </p>
    </div>
  </section>

  <!-- LIFECYCLE & DEPOTS -->
  <section class="w-full py-16 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <LifecycleShowcase />

      <!-- Regional Support Depots -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border-t-4 border-t-blue-600 border-x border-b border-neutral-200 shadow-md">
          <span class="text-xs font-mono font-bold text-blue-700 bg-blue-50 px-2.5 py-1 rounded-md border border-blue-200">WEST HUB</span>
          <h3 class="text-lg font-extrabold text-zinc-950 mt-3 mb-2">Gujarat &amp; Maharashtra</h3>
          <p class="text-xs text-neutral-600 leading-relaxed mb-4">Direct plant engineers covering Ahmedabad, Surat, Ankleshwar, Mumbai, Pune, and Nashik within 24 hours.</p>
          <p class="text-xs font-mono font-bold text-emerald-600">● Status: Rapid Dispatch Active</p>
        </div>

        <div class="p-6 rounded-2xl bg-white border-t-4 border-t-emerald-600 border-x border-b border-neutral-200 shadow-md">
          <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">NORTH HUB</span>
          <h3 class="text-lg font-extrabold text-zinc-950 mt-3 mb-2">Delhi NCR &amp; Rajasthan</h3>
          <p class="text-xs text-neutral-600 leading-relaxed mb-4">Dedicated service squads stationed for Gurugram, Noida, Delhi, Jaipur, Udaipur, and Chandigarh hospitality belts.</p>
          <p class="text-xs font-mono font-bold text-emerald-600">● Status: Rapid Dispatch Active</p>
        </div>

        <div class="p-6 rounded-2xl bg-white border-t-4 border-t-amber-500 border-x border-b border-neutral-200 shadow-md">
          <span class="text-xs font-mono font-bold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-md border border-amber-200">SOUTH &amp; EAST</span>
          <h3 class="text-lg font-extrabold text-zinc-950 mt-3 mb-2">Bengaluru, Hyderabad &amp; Kolkata</h3>
          <p class="text-xs text-neutral-600 leading-relaxed mb-4">Regional technical hubs stocking inverters, bearings, Viton seals, and solenoid valves for 48-hr air/surface turnaround.</p>
          <p class="text-xs font-mono font-bold text-emerald-600">● Status: 10,000+ SKUs Ready</p>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="w-full bg-zinc-950 text-white px-4 sm:px-6 lg:px-8 py-16 md:py-20 text-center industrial-grid-dark">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-3xl font-black tracking-tight mb-4">Need Technical Support or Genuine Spares?</h2>
      <p class="text-neutral-400 text-sm sm:text-base mb-8">
        Contact our pan-India engineering desk for AMC contracts, preventive audits, or urgent spare parts dispatch.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href="tel:+919898029292" class="px-8 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all shadow-lg">
          Call Service Desk: +91 98980 29292
        </a>
        <a href="https://wa.me/919898029292?text=Hello%20Gartech%20Service%20Team,%20I%20need%20technical%20assistance%20or%20spare%20parts." target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 text-sm font-bold text-white bg-emerald-600 rounded-full hover:bg-emerald-500 transition-all">
          WhatsApp Engineer
        </a>
      </div>
    </div>
  </section>
</Layout>
