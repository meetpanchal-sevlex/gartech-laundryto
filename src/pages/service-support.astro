---
import Layout from '../layouts/Layout.astro';
import ServiceCarousel3D from '../components/ServiceCarousel3D.jsx';
---

<Layout title="Service & Support | Gartech Global" description="Gartech Global provides assistance across the complete machinery lifecycle.">
  <section class="w-full px-4 sm:px-6 lg:px-8 py-24 bg-[#FAFAFA]">
    <div class="max-w-4xl mx-auto mb-16 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-100 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        <span class="text-xs font-semibold text-blue-700 tracking-wide uppercase">Interactive 3D Lifecycle</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-950 mb-6">
        Support Beyond the Sale
      </h1>
      <p class="text-lg text-neutral-500 leading-relaxed max-w-2xl mx-auto">
        Professional machinery requires precision at every stage. We don't just drop off equipment; we engineer a complete operational lifecycle. Explore the process below.
      </p>
    </div>

    <!-- LEVEL 3 INTERACTIVE 3D CAROUSEL -->
    <div class="max-w-7xl mx-auto pb-20">
      <ServiceCarousel3D client:load />
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="w-full bg-zinc-950 text-white px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">Need Support for Your Machinery?</h2>
    <p class="text-lg text-neutral-400 mb-10 max-w-2xl mx-auto">
      Contact our pan-India engineering team for installation assistance, technical support, or genuine spare parts.
    </p>
    <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 text-sm font-semibold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all hover:-translate-y-0.5 shadow-lg">
      Contact Support Team
    </a>
  </section>
</Layout>