---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Thank You | Gartech Global" description="Thank you for your quote request.">
  <section class="w-full px-4 sm:px-6 lg:px-8 py-24 min-h-[70vh] flex flex-col items-center justify-center">
    <div class="max-w-2xl mx-auto text-center">
      <div class="w-16 h-16 bg-emerald-100 rounded-2xl flex items-center justify-center mx-auto mb-8 border border-emerald-200">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="text-emerald-600"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Request Received.</h1>
      <p class="text-lg text-neutral-500 mb-10 leading-relaxed">We are reviewing your machinery requirements. Our technical team will prepare your quote and contact you shortly.</p>
      
      <div class="bg-white p-8 md:p-10 rounded-3xl border border-neutral-200/80 card-shadow text-center">
        <h2 class="text-2xl font-bold tracking-tight mb-3">Want to fast-track your quote?</h2>
        <p class="text-neutral-500 mb-8 max-w-md mx-auto">Skip the email back-and-forth. Book a 15-minute scoping call directly with our engineering specialists right now.</p>
        
        <!-- CALENDLY EMBED PLACEHOLDER -->
        <div class="w-full bg-neutral-50 rounded-xl border border-neutral-200/60 p-10 flex flex-col items-center justify-center min-h-[300px]">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" class="text-neutral-400 mb-4"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="1.5"/><line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="1.5"/></svg>
          <p class="font-medium text-neutral-600">Calendly Widget Goes Here</p>
          <p class="text-sm text-neutral-400 mt-2">We will embed your actual Calendly link here once provided.</p>
        </div>
      </div>
      
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-zinc-950 mt-12 hover:text-neutral-600 transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Return to Homepage
      </a>
    </div>
  </section>
</Layout>