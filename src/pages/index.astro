---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gartech Global - Industrial Laundry Machinery">
  <!-- HERO SECTION -->
  <section class="relative w-full min-h-screen flex items-center justify-center overflow-hidden bg-zinc-950 px-4 sm:px-6 lg:px-8">
    <!-- Abstract dark background elements -->
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-900/20 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-zinc-800/40 rounded-full blur-[100px] translate-y-1/3 -translate-x-1/4"></div>
      <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay"></div>
    </div>

    <div class="relative z-10 w-full max-w-4xl pt-24 pb-20 md:py-40">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-neutral-300 text-[10px] md:text-xs font-medium mb-6 md:mb-8 backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse"></span>
        COMMERCIAL & INDUSTRIAL SYSTEMS
      </div>
      
      <h1 class="text-[clamp(2.5rem,8vw,4.5rem)] font-bold tracking-tight text-white mb-4 md:mb-6 leading-[1.1] md:leading-tight">
        Commercial & Industrial<br class="hidden md:block" /> Laundry Machinery.
      </h1>
      
      <p class="text-base md:text-xl text-neutral-400 mb-8 md:mb-10 max-w-2xl leading-relaxed">
        Heavy-duty washing, drying, and finishing equipment from 10 KG to 215 KG capacity. Engineered for reliability and backed by pan-India service.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 md:gap-4">
        <a href="/contact" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 md:py-3.5 text-base md:text-sm font-bold md:font-semibold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all active:scale-95 md:hover:-translate-y-0.5 duration-150 shadow-[0_0_40px_rgba(255,255,255,0.2)]">
          Request a Quote
        </a>
        <a href="/machinery" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 md:py-3.5 text-base md:text-sm font-medium md:font-semibold text-white bg-transparent border border-white/20 rounded-full hover:bg-white/5 transition-all active:scale-95 md:hover:-translate-y-0.5 duration-150">
          View Machinery
        </a>
      </div>
    </div>
  </section>

  <!-- MACHINERY RANGE (ADAPTIVE CAROUSEL) -->
  <section class="w-full py-16 md:py-20 bg-neutral-50/50 overflow-hidden"><div class="max-w-7xl mx-auto px-0 sm:px-6 lg:px-8">
    <div class="px-6 md:px-0 mb-8 md:mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2 md:mb-3">Our Machinery Range</h2>
      <p class="text-neutral-500 text-base md:text-lg">Industrial-grade equipment for every scale of laundry operation.</p>
    </div>

    <!-- Adaptive Carousel (Mobile) / Grid (Desktop) -->
    <div class="flex flex-nowrap md:grid md:grid-cols-3 gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory px-6 md:px-0 pb-8 md:pb-0 hide-scrollbar" style="scroll-padding-left: 1.5rem;">
      
      <!-- Hero Card - Washing Machines -->
      <a href="/machinery/commercial-washing-machines" class="shrink-0 w-[85vw] md:w-auto snap-start md:col-span-2 group relative bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover transition-all duration-300 overflow-hidden md:hover:-translate-y-1">
        <div class="p-6 md:p-8 pb-10 md:pb-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] md:text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-4">Commercial Range</div>
          <h3 class="text-xl md:text-2xl font-bold tracking-tight mb-2">Commercial Washing Machines</h3>
          <p class="text-sm md:text-base text-neutral-500 mb-6 md:mb-8 leading-relaxed">High-extraction, low-water-usage washers built for 24/7 commercial operations. 20 KG to 60 KG capacity range.</p>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 group-hover:gap-2.5 transition-all">
            View Machines <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Steam Press Card -->
      <a href="/steam-press-machines" class="shrink-0 w-[85vw] md:w-auto snap-start group relative bg-zinc-950 text-white rounded-3xl border border-zinc-800 card-shadow hover:card-shadow-hover transition-all duration-300 overflow-hidden md:hover:-translate-y-1">
        <div class="p-6 md:p-8 pb-10 md:pb-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] md:text-xs font-medium bg-white/10 border border-white/10 text-neutral-300 mb-4">Finishing</div>
          <h3 class="text-xl md:text-2xl font-bold tracking-tight mb-2">Steam Press Machines</h3>
          <p class="text-sm md:text-base text-neutral-400 mb-6 md:mb-8 leading-relaxed">Professional steam pressing for dry cleaners, hotels and commercial laundries.</p>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-white group-hover:gap-2.5 transition-all">
            View Models <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
        <div class="absolute -bottom-12 -right-12 w-40 h-40 md:w-48 md:h-48 bg-zinc-900 rounded-[2rem] transform rotate-12 group-hover:rotate-6 transition-transform"></div>
      </a>

      <!-- Laundry Dryers -->
      <a href="/machinery/commercial-laundry-dryers" class="shrink-0 w-[85vw] md:w-auto snap-start group relative bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover transition-all duration-300 md:hover:-translate-y-1 p-6 md:p-8 pb-10 md:pb-8">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] md:text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-4">Commercial</div>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight mb-2">Commercial Laundry Dryers</h3>
        <p class="text-sm md:text-base text-neutral-500 mb-6 md:mb-8 leading-relaxed">Energy-efficient tumble dryers. 20 KG to 60 KG range.</p>
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 group-hover:gap-2.5 transition-all">View Dryers <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>

      <!-- LG Stackers -->
      <a href="/machinery/lg-commercial-stackers" class="shrink-0 w-[85vw] md:w-auto snap-start group relative bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover transition-all duration-300 md:hover:-translate-y-1 p-6 md:p-8 pb-10 md:pb-8">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] md:text-xs font-medium bg-blue-50 border border-blue-100 text-blue-700 mb-4">LG Commercial</div>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight mb-2">LG Commercial Stackers</h3>
        <p class="text-sm md:text-base text-neutral-500 mb-6 md:mb-8 leading-relaxed">Space-saving stacked units. 10 KG and 15 KG models.</p>
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 group-hover:gap-2.5 transition-all">View Stackers <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>

      <!-- Hydra Industrial -->
      <a href="/machinery/hydra-industrial-laundry-machinery" class="shrink-0 w-[85vw] md:w-auto snap-start group relative bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover transition-all duration-300 md:hover:-translate-y-1 p-6 md:p-8 pb-10 md:pb-8">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] md:text-xs font-medium bg-amber-50 border border-amber-100 text-amber-700 mb-4">Industrial</div>
        <h3 class="text-xl md:text-2xl font-bold tracking-tight mb-2">Hydra Industrial Laundry</h3>
        <p class="text-sm md:text-base text-neutral-500 mb-6 md:mb-8 leading-relaxed">Heavy-duty machinery. 30 KG to 215 KG capacity range.</p>
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 group-hover:gap-2.5 transition-all">View Industrial <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </a>

    </div></div></section>

  <!-- INDUSTRIES -->
  <section class="bg-white border-y border-neutral-200/80 py-20">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 md:mb-14">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">Industries We Serve</h2>
        <p class="text-neutral-500 text-base md:text-lg">Machinery solutions for every professional laundry application.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
        {[
          { label: "Hotels & Resorts", icon: '<svg width="24" height="24" md-width="28" md-height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-blue-500 transition-colors duration-300"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>' },
          { label: "Hospitals", icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-rose-500 transition-colors duration-300"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6"/><path d="M12 16v-6"/><path d="M9 13h6"/></svg>' },
          { label: "Dry Cleaners", icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-cyan-500 transition-colors duration-300"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>' },
          { label: "Commercial", icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-amber-500 transition-colors duration-300"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/></svg>' },
          { label: "Garment Mfg", icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-indigo-500 transition-colors duration-300"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" x2="8.12" y1="4" y2="15.88"/><line x1="14.47" x2="20" y1="14.48" y2="20"/><line x1="8.12" x2="12" y1="8.12" y2="12"/></svg>' },
          { label: "Institutions", icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-emerald-500 transition-colors duration-300"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>' },
        ].map((item) => (
          <div class="group flex flex-col items-center justify-center gap-3 p-4 md:p-8 bg-neutral-50 rounded-2xl border border-neutral-200/60 text-center hover:bg-white hover:card-shadow hover:-translate-y-1 transition-all duration-300">
            <div class="w-10 h-10 md:w-12 md:h-12 rounded-xl bg-white border border-neutral-200/80 shadow-sm flex items-center justify-center mb-1 group-hover:scale-110 group-hover:shadow-md transition-all duration-300" set:html={item.icon}></div>
            <span class="text-[11px] md:text-sm font-medium text-neutral-700 leading-tight">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY GARTECH -->
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 md:mb-5">Why Choose Gartech Global?</h2>
        <p class="text-neutral-500 text-base md:text-lg mb-8 leading-relaxed">A machinery partner that understands the complete laundry workflow - from washing and drying to finishing and support.</p>
        <a href="/why-us" class="inline-flex items-center gap-2 px-6 py-3.5 md:py-3 text-base md:text-sm font-bold md:font-semibold text-zinc-950 bg-white border border-neutral-200 rounded-full hover:border-neutral-300 hover:bg-neutral-50 transition-all active:scale-95 md:hover:-translate-y-0.5 duration-150 w-full md:w-auto justify-center">Learn More About Us</a>
      </div>
      <div class="grid grid-cols-1 gap-3 md:gap-4">
        {[
          { title: "Wide Capacity Range", desc: "From 10 KG compact stackers to 215 KG industrial machines." },
          { title: "Multiple Categories", desc: "Washing, drying, finishing and industrial - all in one place." },
          { title: "Application-Based", desc: "Machinery recommendations based on your actual operation." },
          { title: "Complete Workflow", desc: "We consider how machines work together." },
          { title: "After-Sales Support", desc: "Installation, commissioning, guidance and spare parts." },
        ].map((item) => (
          <div class="flex items-start gap-4 p-4 md:p-5 bg-white rounded-2xl border border-neutral-200/80 card-shadow">
            <div class="w-8 h-8 rounded-lg bg-zinc-950 flex items-center justify-center shrink-0 mt-0.5">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2.5 7l3.5 3.5 5.5-6" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div>
              <p class="font-semibold text-sm text-zinc-950">{item.title}</p>
              <p class="text-neutral-500 text-sm mt-0.5">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION - full bleed dark -->
  <section class="w-full bg-zinc-950 py-20 md:py-24 px-6 md:px-8">
    <div class="w-full max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white mb-4">Ready to Build Your Laundry Operation?</h2>
      <p class="text-neutral-400 text-base md:text-lg mb-8">Tell us your daily volume, machine requirements, and business type - we will recommend the right setup for you.</p>
      <a href="/contact" class="inline-flex items-center justify-center w-full sm:w-auto px-8 py-4 text-base font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all active:scale-95 md:hover:-translate-y-0.5 duration-150">
        Request a Free Quote
      </a>
    </div>
  </section>

</Layout>