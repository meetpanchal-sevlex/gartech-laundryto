---
import Layout from '../layouts/Layout.astro';
import InteractiveDrum3D from '../components/InteractiveDrum3D.astro';
---

<Layout title="Gartech Global - Industrial Laundry Machinery & Commercial Washing Systems">

  <!-- HERO SECTION -->
  <section class="relative w-full pt-16 pb-12 md:py-24 flex items-center overflow-hidden bg-zinc-950 border-b border-zinc-900">
    <!-- Atmospheric background elements -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-900/20 rounded-full blur-[140px] -translate-y-1/2 translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-zinc-800/40 rounded-full blur-[120px] translate-y-1/3 -translate-x-1/4"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-blue-950/20 via-transparent to-transparent opacity-60"></div>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-10 lg:gap-14">
      
      <!-- LEFT: Content -->
      <div class="w-full lg:w-7/12 flex flex-col items-start text-left">
        
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-neutral-300 text-xs font-semibold mb-6 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>EST. 1998 &bull; PAN-INDIA INDUSTRIAL LAUNDRY MANUFACTURER</span>
        </div>
        
        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white mb-5 leading-[1.1] md:leading-[1.08]">
          Commercial &amp; Industrial<br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-neutral-200 to-neutral-400">Laundry Machinery.</span>
        </h1>
        
        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-neutral-400 mb-8 max-w-2xl leading-relaxed">
          Heavy-duty washing, drying, and garment finishing equipment engineered for 24/7 continuous duty cycles. From <strong class="text-white font-semibold">10 KG to 215 KG</strong> capacity, supported by guaranteed 24-48 hr pan-India on-site service.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto mb-8">
          <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all active:scale-95 shadow-[0_0_30px_rgba(255,255,255,0.15)]">
            Request Price Quote
          </a>
          <a href="/price-list" class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold text-white bg-white/10 border border-white/15 rounded-full hover:bg-white/15 transition-all active:scale-95">
            View Price List &amp; Specs
          </a>
          <a href="/contact#catalogue" class="inline-flex items-center justify-center gap-1.5 px-6 py-3.5 text-sm font-medium text-neutral-300 hover:text-white transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Brochure (PDF)
          </a>
        </div>

        <!-- Trust Mini Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/10 w-full text-xs text-neutral-400">
          <div>
            <span class="block text-white font-bold text-base">25+ Yrs</span>
            <span class="text-[11px] text-neutral-500">Engineering Trust</span>
          </div>
          <div>
            <span class="block text-white font-bold text-base">1,200+</span>
            <span class="text-[11px] text-neutral-500">Installations</span>
          </div>
          <div>
            <span class="block text-white font-bold text-base">24-48 Hr</span>
            <span class="text-[11px] text-neutral-500">Pan-India Service</span>
          </div>
          <div>
            <span class="block text-white font-bold text-base">ISO 9001</span>
            <span class="text-[11px] text-neutral-500">Quality Certified</span>
          </div>
        </div>

      </div>

      <!-- RIGHT: Interactive 3D Drum Canvas -->
      <div class="w-full lg:w-5/12 h-[340px] sm:h-[420px] lg:h-[520px] relative flex items-center justify-center">
        <InteractiveDrum3D />
      </div>

    </div>
  </section>

  <!-- QUICK INDUSTRIAL STATS RIBBON (Shaikh Petroleum Standard) -->
  <section class="w-full bg-white border-b border-neutral-200/80 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center text-center md:text-left">
        
        <div class="flex items-center justify-center md:justify-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 border border-blue-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <p class="font-bold text-sm text-zinc-950">AISI 304 Stainless Steel</p>
            <p class="text-xs text-neutral-500">Corrosion-proof drum &amp; chassis</p>
          </div>
        </div>

        <div class="flex items-center justify-center md:justify-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div>
            <p class="font-bold text-sm text-zinc-950">Up to 35% Energy Savings</p>
            <p class="text-xs text-neutral-500">Inverter variable frequency drives</p>
          </div>
        </div>

        <div class="flex items-center justify-center md:justify-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div>
            <p class="font-bold text-sm text-zinc-950">Direct Plant Dispatch</p>
            <p class="text-xs text-neutral-500">Ex-works GIDC Estate, Gujarat</p>
          </div>
        </div>

        <div class="flex items-center justify-center md:justify-start gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0 border border-purple-100">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <p class="font-bold text-sm text-zinc-950">Turnkey Facility Support</p>
            <p class="text-xs text-neutral-500">CAD layouts &amp; utility planning</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- MACHINERY CATEGORIES (Shaikh Petroleum Best Products Model) -->
  <section class="w-full py-16 md:py-20 bg-neutral-50/60 overflow-hidden border-b border-neutral-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-bold font-mono uppercase text-blue-600 tracking-wider">Product Categories</span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-zinc-950 mt-1">Our Core Machinery Portfolio</h2>
          <p class="text-neutral-500 text-sm sm:text-base mt-1">Engineered for commercial laundromats, luxury hotels, multi-specialty hospitals, and garment export units.</p>
        </div>
        <a href="/price-list" class="inline-flex items-center gap-1.5 text-sm font-bold text-blue-600 hover:text-blue-700 shrink-0">
          <span>Compare All 14 Models &amp; Specs</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Categories Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- 1. Commercial Washers -->
        <div class="bg-white rounded-2xl border border-neutral-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-100">20 KG to 120 KG</span>
              <span class="text-xs text-neutral-400 font-mono">GHW SERIES</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-950 mb-2">Commercial Washing Machines</h3>
            <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed mb-6">
              High-extraction programmable washer extractors with up to 350 G-force. Microprocessor control with customizable chemical injection programs.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-600 mb-6 bg-neutral-50 p-3.5 rounded-xl border border-neutral-200/60 font-mono">
              <p>&bull; Heating: Steam / Electric</p>
              <p>&bull; Extract Speed: Up to 950 RPM</p>
              <p>&bull; Ideal for: Hotels, Hospitals, Central Plants</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/commercial-washing-machines" class="flex-1 py-2 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors">
              View Models
            </a>
            <a href="/contact?category=washers" class="flex-1 py-2 text-center rounded-xl border border-neutral-200 text-zinc-900 text-xs font-semibold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 2. Industrial Dryers -->
        <div class="bg-white rounded-2xl border border-neutral-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-100">15 KG to 100 KG</span>
              <span class="text-xs text-neutral-400 font-mono">GAD SERIES</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-950 mb-2">Industrial Tumble Dryers</h3>
            <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed mb-6">
              Axial &amp; radial airflow technology ensuring rapid moisture extraction with minimum fabric abrasion. Bi-directional reversing cylinder prevents balling.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-600 mb-6 bg-neutral-50 p-3.5 rounded-xl border border-neutral-200/60 font-mono">
              <p>&bull; Heating: Steam / Piped Gas / Electric</p>
              <p>&bull; Drum: Stainless Steel AISI 304</p>
              <p>&bull; Ideal for: High-turnover Linen &amp; Uniforms</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/commercial-laundry-dryers" class="flex-1 py-2 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors">
              View Models
            </a>
            <a href="/contact?category=dryers" class="flex-1 py-2 text-center rounded-xl border border-neutral-200 text-zinc-900 text-xs font-semibold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 3. LG Stacker Towers -->
        <div class="bg-white rounded-2xl border border-neutral-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">10 KG &bull; 15 KG</span>
              <span class="text-xs text-neutral-400 font-mono">LG COMMERCIAL</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-950 mb-2">LG Commercial Stackers</h3>
            <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed mb-6">
              Vertical stacked washer + dryer towers designed for laundromats, boutique hotels, and student hostels. Inverter DirectDrive for quiet operation.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-600 mb-6 bg-neutral-50 p-3.5 rounded-xl border border-neutral-200/60 font-mono">
              <p>&bull; Footprint: Ultra-compact (half floor space)</p>
              <p>&bull; Payment: UPI / Card / Token compatible</p>
              <p>&bull; Ideal for: Urban Laundromats &amp; Resorts</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/lg-commercial-stackers" class="flex-1 py-2 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors">
              View Models
            </a>
            <a href="/contact?category=stackers" class="flex-1 py-2 text-center rounded-xl border border-neutral-200 text-zinc-900 text-xs font-semibold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 4. Hydra Barrier Washers -->
        <div class="bg-white rounded-2xl border border-neutral-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">60 KG to 215 KG</span>
              <span class="text-xs text-neutral-400 font-mono">HYDRA BARRIER</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-950 mb-2">Hydra Barrier Washers</h3>
            <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed mb-6">
              Dual-door pass-through barrier washers built for cleanrooms, sterile hospital linen, and pharmaceutical manufacturing to prevent cross-contamination.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-600 mb-6 bg-neutral-50 p-3.5 rounded-xl border border-neutral-200/60 font-mono">
              <p>&bull; Design: Wall pass-through isolation</p>
              <p>&bull; Standard: Cleanroom / NABH / WHO Hygiene</p>
              <p>&bull; Ideal for: Large Hospitals &amp; Pharma</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/hydra-industrial-laundry-machinery" class="flex-1 py-2 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors">
              View Models
            </a>
            <a href="/contact?category=hydra" class="flex-1 py-2 text-center rounded-xl border border-neutral-200 text-zinc-900 text-xs font-semibold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 5. Steam Press Model Alpha -->
        <div class="bg-white rounded-2xl border border-neutral-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-100">120 Pieces / Hr</span>
              <span class="text-xs text-neutral-400 font-mono">FINISHING RANGE</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-950 mb-2">Steam Press Model Alpha</h3>
            <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed mb-6">
              Pneumatic steam pressing machine with vacuum buck and foot pedal control. Delivers crisp, dry cleaner-grade creases with zero fabric shine.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-600 mb-6 bg-neutral-50 p-3.5 rounded-xl border border-neutral-200/60 font-mono">
              <p>&bull; Head: Cast Aluminum with Teflon Shoe</p>
              <p>&bull; Vacuum: High-power built-in suction</p>
              <p>&bull; Ideal for: Suits, Trousers &amp; Formal Uniforms</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/steam-press-machines/model-alpha" class="flex-1 py-2 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors">
              View Specs
            </a>
            <a href="/contact?category=model-alpha" class="flex-1 py-2 text-center rounded-xl border border-neutral-200 text-zinc-900 text-xs font-semibold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 6. Flatwork Ironers & Boilers -->
        <div class="bg-white rounded-2xl border border-neutral-200/80 p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-shadow">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-neutral-100 text-neutral-800 border border-neutral-200">1.8 M to 3.2 M Roll</span>
              <span class="text-xs text-neutral-400 font-mono">FLATWORK</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-950 mb-2">Flatwork Bed Sheet Ironers</h3>
            <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed mb-6">
              Industrial heated roller ironers for continuous bed sheets, duvet covers, and tablecloth processing at speeds up to 12 meters per minute.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-600 mb-6 bg-neutral-50 p-3.5 rounded-xl border border-neutral-200/60 font-mono">
              <p>&bull; Rollers: Single, Double &amp; Triple Roll</p>
              <p>&bull; Heating: Steam / Electric / Thermic Fluid</p>
              <p>&bull; Ideal for: Star Hotels &amp; Commercial Laundries</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/garment-finishing" class="flex-1 py-2 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors">
              View Finishing
            </a>
            <a href="/contact?category=ironers" class="flex-1 py-2 text-center rounded-xl border border-neutral-200 text-zinc-900 text-xs font-semibold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SPECIFICATION & PRICE LIST PREVIEW TABLE (Shaikh Petroleum Model) -->
  <section class="w-full py-16 bg-white border-b border-neutral-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <span class="text-xs font-bold font-mono uppercase text-emerald-600 tracking-wider">Quick Specification Index</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-950 mt-1">Industrial Machine Specifications &amp; Pricing Slabs</h2>
          <p class="text-neutral-500 text-sm mt-1">Ex-works baseline rates for immediate procurement planning. Complete pricing schedule on the dedicated page.</p>
        </div>
        <a href="/price-list" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-all shrink-0">
          View Complete 14-Model Table &rarr;
        </a>
      </div>

      <!-- Preview Table -->
      <div class="bg-white rounded-2xl border border-neutral-200/80 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse min-w-[700px]">
            <thead class="bg-neutral-50 text-neutral-500 font-mono uppercase text-[10px] border-b border-neutral-200/80">
              <tr>
                <th class="py-3.5 px-4 font-bold">Model Name</th>
                <th class="py-3.5 px-4 font-bold">Capacity</th>
                <th class="py-3.5 px-4 font-bold">Drum Spec</th>
                <th class="py-3.5 px-4 font-bold">Heating</th>
                <th class="py-3.5 px-4 font-bold text-right">Base Price (INR)*</th>
                <th class="py-3.5 px-4 text-center font-bold">Quick Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200/60 font-sans">
              <tr class="hover:bg-neutral-50/60 transition-colors">
                <td class="py-3 px-4 font-bold text-zinc-950">Gartech GHW-20 Washer</td>
                <td class="py-3 px-4 font-semibold text-blue-700">20 KG</td>
                <td class="py-3 px-4 text-neutral-600">350 G-Force &bull; 950 RPM</td>
                <td class="py-3 px-4 text-neutral-600">Electric / Steam</td>
                <td class="py-3 px-4 text-right font-mono font-bold text-zinc-950">₹ 2,85,000*</td>
                <td class="py-3 px-4 text-center"><a href="/contact?model=GHW-20" class="text-blue-600 hover:underline font-bold">Get Quote</a></td>
              </tr>
              <tr class="hover:bg-neutral-50/60 transition-colors">
                <td class="py-3 px-4 font-bold text-zinc-950">Gartech GHW-35 Washer</td>
                <td class="py-3 px-4 font-semibold text-blue-700">35 KG</td>
                <td class="py-3 px-4 text-neutral-600">350 G-Force &bull; 900 RPM</td>
                <td class="py-3 px-4 text-neutral-600">Steam / Electric</td>
                <td class="py-3 px-4 text-right font-mono font-bold text-zinc-950">₹ 3,95,000*</td>
                <td class="py-3 px-4 text-center"><a href="/contact?model=GHW-35" class="text-blue-600 hover:underline font-bold">Get Quote</a></td>
              </tr>
              <tr class="hover:bg-neutral-50/60 transition-colors">
                <td class="py-3 px-4 font-bold text-zinc-950">Gartech GAD-50 Dryer</td>
                <td class="py-3 px-4 font-semibold text-amber-700">50 KG</td>
                <td class="py-3 px-4 text-neutral-600">1,020 L Reversing Drum</td>
                <td class="py-3 px-4 text-neutral-600">Steam / Gas</td>
                <td class="py-3 px-4 text-right font-mono font-bold text-zinc-950">₹ 3,85,000*</td>
                <td class="py-3 px-4 text-center"><a href="/contact?model=GAD-50" class="text-blue-600 hover:underline font-bold">Get Quote</a></td>
              </tr>
              <tr class="hover:bg-neutral-50/60 transition-colors">
