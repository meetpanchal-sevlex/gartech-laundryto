---
import Layout from '../layouts/Layout.astro';
import InteractiveDrum3D from '../components/InteractiveDrum3D.astro';
---

<Layout title="Gartech Global - Industrial Laundry Machinery & Commercial Washing Systems">

  <!-- HERO SECTION (Deep Industrial Carbon + Subtle CAD Grid) -->
  <section class="relative w-full pt-16 pb-16 md:py-28 flex items-center overflow-hidden bg-zinc-950 border-b border-zinc-900 industrial-grid-dark">
    <!-- Atmospheric background elements -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute top-0 right-0 w-[650px] h-[650px] bg-blue-900/25 rounded-full blur-[140px] -translate-y-1/2 translate-x-1/3"></div>
      <div class="absolute bottom-0 left-0 w-[550px] h-[550px] bg-zinc-800/50 rounded-full blur-[120px] translate-y-1/3 -translate-x-1/4"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-blue-950/20 via-transparent to-zinc-950/80"></div>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row items-center gap-10 lg:gap-14">
      
      <!-- LEFT: Content -->
      <div class="w-full lg:w-7/12 flex flex-col items-start text-left">
        
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/15 text-neutral-200 text-xs font-semibold mb-6 backdrop-blur-md shadow-inner">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>EST. 1998 &bull; PAN-INDIA INDUSTRIAL LAUNDRY MANUFACTURER</span>
        </div>
        
        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white mb-5 leading-[1.1] md:leading-[1.08]">
          Commercial &amp; Industrial<br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-white to-neutral-300">Laundry Machinery.</span>
        </h1>
        
        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-neutral-300 mb-8 max-w-2xl leading-relaxed font-normal">
          Heavy-duty washing, drying, and garment finishing equipment engineered for 24/7 continuous duty cycles. From <strong class="text-white font-bold bg-white/10 px-2 py-0.5 rounded">10 KG to 215 KG</strong> capacity, supported by guaranteed 24-48 hr pan-India on-site service.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto mb-8">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all active:scale-95 shadow-[0_0_35px_rgba(255,255,255,0.25)] hover:shadow-[0_0_45px_rgba(255,255,255,0.35)]">
            Request Price Quote
          </a>
          <a href="/price-list" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-bold text-white bg-blue-600/90 border border-blue-500 rounded-full hover:bg-blue-600 transition-all active:scale-95 shadow-md shadow-blue-900/30">
            View Price List &amp; Specs &rarr;
          </a>
          <a href="/contact#catalogue" class="inline-flex items-center justify-center gap-1.5 px-5 py-3.5 text-sm font-medium text-neutral-300 hover:text-white transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Brochure (PDF)
          </a>
        </div>

        <!-- Trust Mini Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-white/10 w-full text-xs text-neutral-400">
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/5">
            <span class="block text-white font-bold text-lg font-mono">25+ Yrs</span>
            <span class="text-[11px] text-neutral-400">Engineering Trust</span>
          </div>
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/5">
            <span class="block text-white font-bold text-lg font-mono">1,200+</span>
            <span class="text-[11px] text-neutral-400">Installations</span>
          </div>
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/5">
            <span class="block text-white font-bold text-lg font-mono">24-48 Hr</span>
            <span class="text-[11px] text-neutral-400">Pan-India Service</span>
          </div>
          <div class="p-2.5 rounded-xl bg-white/5 border border-white/5">
            <span class="block text-white font-bold text-lg font-mono">ISO 9001</span>
            <span class="text-[11px] text-neutral-400">Quality Certified</span>
          </div>
        </div>

      </div>

      <!-- RIGHT: Interactive 3D Drum Canvas -->
      <div class="w-full lg:w-5/12 h-[340px] sm:h-[420px] lg:h-[520px] relative flex items-center justify-center">
        <InteractiveDrum3D />
      </div>

    </div>
  </section>

  <!-- ELEVATED TRUST STATS CAPSULE (Breaks the Hero/Body barrier with 3D elevation) -->
  <section class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 sm:-mt-10 mb-12">
    <div class="bg-white rounded-2xl border border-neutral-300 shadow-[0_10px_35px_-5px_rgba(0,0,0,0.12),0_2px_8px_rgba(0,0,0,0.06)] p-5 sm:p-7">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-center">
        
        <div class="flex items-center gap-3.5 p-2">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 border border-blue-200 shadow-xs">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div>
            <p class="font-extrabold text-sm text-zinc-950">AISI 304 Stainless Steel</p>
            <p class="text-xs text-neutral-500 mt-0.5">Corrosion-proof drum &amp; chassis</p>
          </div>
        </div>

        <div class="flex items-center gap-3.5 p-2 border-t sm:border-t-0 sm:border-l border-neutral-200">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-200 shadow-xs">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div>
            <p class="font-extrabold text-sm text-zinc-950">Up to 35% Utility Savings</p>
            <p class="text-xs text-neutral-500 mt-0.5">Variable frequency drives &amp; auto-rinse</p>
          </div>
        </div>

        <div class="flex items-center gap-3.5 p-2 border-t lg:border-t-0 lg:border-l border-neutral-200">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-200 shadow-xs">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <div>
            <p class="font-extrabold text-sm text-zinc-950">Direct Plant Dispatch</p>
            <p class="text-xs text-neutral-500 mt-0.5">GIDC Industrial Estate, Gujarat</p>
          </div>
        </div>

        <div class="flex items-center gap-3.5 p-2 border-t sm:border-t-0 sm:border-l border-neutral-200">
          <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center shrink-0 border border-purple-200 shadow-xs">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <p class="font-extrabold text-sm text-zinc-950">Turnkey Sizing &amp; CAD</p>
            <p class="text-xs text-neutral-500 mt-0.5">Architectural utility drawings</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- MACHINERY CATEGORIES (Architectural Cool-Gray Surface + Elevated Highlight Cards) -->
  <section class="w-full py-12 md:py-20 relative industrial-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 pb-6 border-b border-neutral-300">
        <div>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-blue-100 text-blue-800 text-xs font-bold font-mono uppercase tracking-wider">
            Engineered Hardware Portfolio
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-zinc-950 mt-2">
            Heavy-Duty Machinery Categories
          </h2>
          <p class="text-neutral-600 text-sm sm:text-base mt-1 max-w-2xl">
            High-extraction washers, reversing tumble dryers, automated multi-housing towers, and pass-through barrier systems.
          </p>
        </div>
        <a href="/price-list" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white border border-neutral-300 shadow-sm text-xs font-bold text-zinc-950 hover:bg-neutral-50 transition-all shrink-0">
          <span>Compare All 14 Models &amp; Specs</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Categories Grid with Top Colored Accents and Crisp Card Elevation -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- 1. Commercial Washers -->
        <div class="bg-white rounded-2xl border-t-4 border-t-blue-600 border-x border-b border-neutral-200/90 p-6 flex flex-col justify-between shadow-[0_4px_16px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.12)] hover:-translate-y-1.5 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-extrabold bg-blue-50 text-blue-700 border border-blue-200">20 KG to 120 KG</span>
              <span class="text-xs text-neutral-400 font-mono font-bold">GHW SERIES</span>
            </div>
            <h3 class="text-xl font-black text-zinc-950 mb-2">Commercial Washing Machines</h3>
            <p class="text-neutral-600 text-xs sm:text-sm leading-relaxed mb-5">
              High-extraction programmable washer extractors with up to 350 G-force. Microprocessor control with customizable chemical injection programs.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-700 mb-6 bg-neutral-100/80 p-3.5 rounded-xl border border-neutral-200 font-mono">
              <p>&bull; <strong>Heating:</strong> Steam / Electric</p>
              <p>&bull; <strong>Extract Speed:</strong> Up to 950 RPM</p>
              <p>&bull; <strong>Ideal for:</strong> Hotels, Hospitals, Central Plants</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/commercial-washing-machines" class="flex-1 py-2.5 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors shadow-xs">
              View Models
            </a>
            <a href="/contact?category=washers" class="flex-1 py-2.5 text-center rounded-xl border border-neutral-300 text-zinc-950 text-xs font-bold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 2. Industrial Dryers -->
        <div class="bg-white rounded-2xl border-t-4 border-t-amber-500 border-x border-b border-neutral-200/90 p-6 flex flex-col justify-between shadow-[0_4px_16px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.12)] hover:-translate-y-1.5 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-extrabold bg-amber-50 text-amber-700 border border-amber-200">15 KG to 100 KG</span>
              <span class="text-xs text-neutral-400 font-mono font-bold">GAD SERIES</span>
            </div>
            <h3 class="text-xl font-black text-zinc-950 mb-2">Industrial Tumble Dryers</h3>
            <p class="text-neutral-600 text-xs sm:text-sm leading-relaxed mb-5">
              Axial &amp; radial airflow technology ensuring rapid moisture extraction with minimum fabric abrasion. Bi-directional reversing cylinder prevents balling.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-700 mb-6 bg-neutral-100/80 p-3.5 rounded-xl border border-neutral-200 font-mono">
              <p>&bull; <strong>Heating:</strong> Steam / Piped Gas / Electric</p>
              <p>&bull; <strong>Drum:</strong> Stainless Steel AISI 304</p>
              <p>&bull; <strong>Ideal for:</strong> High-turnover Linen &amp; Uniforms</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/commercial-laundry-dryers" class="flex-1 py-2.5 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors shadow-xs">
              View Models
            </a>
            <a href="/contact?category=dryers" class="flex-1 py-2.5 text-center rounded-xl border border-neutral-300 text-zinc-950 text-xs font-bold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 3. LG Stacker Towers -->
        <div class="bg-white rounded-2xl border-t-4 border-t-indigo-600 border-x border-b border-neutral-200/90 p-6 flex flex-col justify-between shadow-[0_4px_16px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.12)] hover:-translate-y-1.5 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-extrabold bg-indigo-50 text-indigo-700 border border-indigo-200">10 KG &bull; 15 KG</span>
              <span class="text-xs text-neutral-400 font-mono font-bold">LG COMMERCIAL</span>
            </div>
            <h3 class="text-xl font-black text-zinc-950 mb-2">LG Commercial Stackers</h3>
            <p class="text-neutral-600 text-xs sm:text-sm leading-relaxed mb-5">
              Vertical stacked washer + dryer towers designed for laundromats, boutique hotels, and student hostels. Inverter DirectDrive for quiet operation.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-700 mb-6 bg-neutral-100/80 p-3.5 rounded-xl border border-neutral-200 font-mono">
              <p>&bull; <strong>Footprint:</strong> Half floor space footprint</p>
              <p>&bull; <strong>Payment:</strong> UPI / Card / Token compatible</p>
              <p>&bull; <strong>Ideal for:</strong> Urban Laundromats &amp; Resorts</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/lg-commercial-stackers" class="flex-1 py-2.5 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors shadow-xs">
              View Models
            </a>
            <a href="/contact?category=stackers" class="flex-1 py-2.5 text-center rounded-xl border border-neutral-300 text-zinc-950 text-xs font-bold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 4. Hydra Barrier Washers -->
        <div class="bg-white rounded-2xl border-t-4 border-t-emerald-600 border-x border-b border-neutral-200/90 p-6 flex flex-col justify-between shadow-[0_4px_16px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.12)] hover:-translate-y-1.5 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200">60 KG to 215 KG</span>
              <span class="text-xs text-neutral-400 font-mono font-bold">HYDRA BARRIER</span>
            </div>
            <h3 class="text-xl font-black text-zinc-950 mb-2">Hydra Barrier Washers</h3>
            <p class="text-neutral-600 text-xs sm:text-sm leading-relaxed mb-5">
              Dual-door pass-through barrier washers built for cleanrooms, sterile hospital linen, and pharmaceutical manufacturing to prevent cross-contamination.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-700 mb-6 bg-neutral-100/80 p-3.5 rounded-xl border border-neutral-200 font-mono">
              <p>&bull; <strong>Design:</strong> Wall pass-through isolation</p>
              <p>&bull; <strong>Standard:</strong> Cleanroom / NABH / WHO Hygiene</p>
              <p>&bull; <strong>Ideal for:</strong> Large Hospitals &amp; Pharma</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/machinery/hydra-industrial-laundry-machinery" class="flex-1 py-2.5 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors shadow-xs">
              View Models
            </a>
            <a href="/contact?category=hydra" class="flex-1 py-2.5 text-center rounded-xl border border-neutral-300 text-zinc-950 text-xs font-bold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 5. Steam Press Model Alpha -->
        <div class="bg-white rounded-2xl border-t-4 border-t-purple-600 border-x border-b border-neutral-200/90 p-6 flex flex-col justify-between shadow-[0_4px_16px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.12)] hover:-translate-y-1.5 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-extrabold bg-purple-50 text-purple-700 border border-purple-200">120 Pieces / Hr</span>
              <span class="text-xs text-neutral-400 font-mono font-bold">FINISHING RANGE</span>
            </div>
            <h3 class="text-xl font-black text-zinc-950 mb-2">Steam Press Model Alpha</h3>
            <p class="text-neutral-600 text-xs sm:text-sm leading-relaxed mb-5">
              Pneumatic steam pressing machine with vacuum buck and foot pedal control. Delivers crisp, dry cleaner-grade creases with zero fabric shine.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-700 mb-6 bg-neutral-100/80 p-3.5 rounded-xl border border-neutral-200 font-mono">
              <p>&bull; <strong>Head:</strong> Cast Aluminum with Teflon Shoe</p>
              <p>&bull; <strong>Vacuum:</strong> High-power built-in suction</p>
              <p>&bull; <strong>Ideal for:</strong> Suits, Trousers &amp; Uniforms</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/steam-press-machines/model-alpha" class="flex-1 py-2.5 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors shadow-xs">
              View Specs
            </a>
            <a href="/contact?category=model-alpha" class="flex-1 py-2.5 text-center rounded-xl border border-neutral-300 text-zinc-950 text-xs font-bold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

        <!-- 6. Flatwork Ironers & Boilers -->
        <div class="bg-white rounded-2xl border-t-4 border-t-zinc-800 border-x border-b border-neutral-200/90 p-6 flex flex-col justify-between shadow-[0_4px_16px_rgba(0,0,0,0.05)] hover:shadow-[0_16px_36px_-6px_rgba(0,0,0,0.12)] hover:-translate-y-1.5 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-extrabold bg-neutral-100 text-neutral-800 border border-neutral-200">1.8 M to 3.2 M Roll</span>
              <span class="text-xs text-neutral-400 font-mono font-bold">FLATWORK</span>
            </div>
            <h3 class="text-xl font-black text-zinc-950 mb-2">Flatwork Bed Sheet Ironers</h3>
            <p class="text-neutral-600 text-xs sm:text-sm leading-relaxed mb-5">
              Industrial heated roller ironers for continuous bed sheets, duvet covers, and tablecloth processing at speeds up to 12 meters per minute.
            </p>
            <div class="space-y-1.5 text-xs text-neutral-700 mb-6 bg-neutral-100/80 p-3.5 rounded-xl border border-neutral-200 font-mono">
              <p>&bull; <strong>Rollers:</strong> Single, Double &amp; Triple Roll</p>
              <p>&bull; <strong>Heating:</strong> Steam / Electric / Thermic Fluid</p>
              <p>&bull; <strong>Ideal for:</strong> Star Hotels &amp; Commercial Laundries</p>
            </div>
          </div>
          <div class="flex items-center gap-2 pt-4 border-t border-neutral-100">
            <a href="/garment-finishing" class="flex-1 py-2.5 text-center rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors shadow-xs">
              View Finishing
            </a>
            <a href="/contact?category=ironers" class="flex-1 py-2.5 text-center rounded-xl border border-neutral-300 text-zinc-950 text-xs font-bold hover:bg-neutral-50 transition-colors">
              Get Quote
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- SPECIFICATION & PRICE LIST PREVIEW TABLE (Framed High-Contrast Engineering Terminal) -->
  <section class="w-full py-16 bg-[#E9EBEF] border-y border-neutral-300 dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <span class="px-2.5 py-1 rounded-md bg-emerald-100 text-emerald-800 text-xs font-extrabold font-mono uppercase tracking-wider">
            Procurement Schedule FY 2026-27
          </span>
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-zinc-950 mt-2">
            Machine Specifications &amp; Pricing Slabs
          </h2>
          <p class="text-neutral-600 text-sm mt-1">
            Ex-works factory baseline rates. For complete engineering parameters, open the comprehensive price list.
          </p>
        </div>
        <a href="/price-list" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-all shadow-md shrink-0">
          View Full 14-Model Schedule &rarr;
        </a>
      </div>

      <!-- Preview Table Container -->
