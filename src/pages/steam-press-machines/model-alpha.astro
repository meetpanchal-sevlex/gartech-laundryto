---
import Layout from "../../layouts/Layout.astro";

// This is a comprehensive, SEO-optimized Product Page Template
// Based exactly on the "1,000-1,500 words" structure requested in the document.

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": "Industrial Steam Press Machine [Model Name]",
  "description": "Heavy-duty industrial steam press machine for commercial laundries, hotels, and garment manufacturers.",
  "brand": {
    "@type": "Brand",
    "name": "Gartech Global"
  }
};
---
<Layout title="Industrial Steam Press Machine | Gartech Global" description="Heavy-duty industrial steam press for commercial laundries and hotels. Engineered for high-volume garment finishing with unmatched ROI.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- HERO SECTION: Product Overview -->
  <section class="w-full bg-zinc-950 text-white px-8 md:px-12 lg:px-16 xl:px-20 pt-24 pb-20 border-b border-white/10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="flex flex-col items-start">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          <span class="text-xs font-medium text-neutral-300 tracking-wide uppercase">Steam Press Machinery</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter mb-6">
          Industrial Steam Press<br/>
          <span class="text-neutral-500">[Model Name]</span>
        </h1>
        <p class="text-lg text-neutral-400 mb-8 leading-relaxed max-w-lg">
          The ultimate finishing solution for high-volume laundries. Engineered to deliver crisp, professional garment finishing while significantly reducing operator fatigue and utility consumption.
        </p>
        <div class="flex gap-4">
          <a href="/contact" class="px-8 py-3.5 bg-white text-zinc-950 font-semibold rounded-full hover:bg-neutral-200 transition-colors">Request Quote</a>
          <a href="#specifications" class="px-8 py-3.5 border border-white/20 text-white font-semibold rounded-full hover:bg-white/5 transition-colors">View Specs</a>
        </div>
      </div>
      
      <!-- Premium Product Image Stage -->
      <div class="relative w-full aspect-square bg-zinc-900 rounded-3xl border border-white/10 flex items-center justify-center overflow-hidden group">
        <div class="absolute inset-0 bg-blue-500/10 blur-[100px] rounded-full scale-150"></div>
        <div class="relative z-10 flex flex-col items-center text-neutral-600">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242M12 12v9"/><path d="m8 17 4-4 4 4"/></svg>
          <p class="mt-4 font-mono text-sm uppercase tracking-widest">Awaiting Product Photo</p>
        </div>
      </div>
    </div>
  </section>

  <!-- KEY FEATURES (Bento Grid) -->
  <section class="w-full bg-[#F4F4F5] px-8 md:px-12 lg:px-16 xl:px-20 py-20">
    <h2 class="text-3xl font-bold tracking-tight text-zinc-950 mb-12 text-center">Engineered for Dominance</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
      <div class="bg-white p-8 rounded-3xl border border-neutral-200/80 shadow-sm">
        <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center mb-6 border border-blue-100 text-blue-600">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-zinc-950 mb-3">Rapid Heat Recovery</h3>
        <p class="text-neutral-500 text-sm leading-relaxed">[Feature description: Explain how the boiler recovers temperature quickly between presses for zero downtime.]</p>
      </div>
      <div class="bg-white p-8 rounded-3xl border border-neutral-200/80 shadow-sm">
        <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center mb-6 border border-emerald-100 text-emerald-600">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-zinc-950 mb-3">Operator Safety</h3>
        <p class="text-neutral-500 text-sm leading-relaxed">[Feature description: Details about two-hand operation, safety guards, and ergonomic design.]</p>
      </div>
      <div class="bg-white p-8 rounded-3xl border border-neutral-200/80 shadow-sm">
        <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center mb-6 border border-amber-100 text-amber-600">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="text-lg font-semibold text-zinc-950 mb-3">Built for India</h3>
        <p class="text-neutral-500 text-sm leading-relaxed">[Feature description: Explain resilience to voltage fluctuations and hard water conditions.]</p>
      </div>
    </div>
  </section>

  <!-- TECHNICAL SPECIFICATIONS -->
  <section id="specifications" class="w-full bg-white px-8 md:px-12 lg:px-16 xl:px-20 py-20">
    <div class="w-full">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-950 mb-8">Technical Specifications</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-zinc-950 text-sm uppercase tracking-wider text-zinc-500">
              <th class="py-4 font-semibold">Specification</th>
              <th class="py-4 font-semibold">Value</th>
            </tr>
          </thead>
          <tbody class="text-zinc-950">
            <tr class="border-b border-neutral-200">
              <td class="py-4 font-medium text-neutral-600">Model Number</td>
              <td class="py-4 font-semibold">[Insert Model]</td>
            </tr>
            <tr class="border-b border-neutral-200">
              <td class="py-4 font-medium text-neutral-600">Power Rating (kW)</td>
              <td class="py-4 font-semibold">[Insert Power]</td>
            </tr>
            <tr class="border-b border-neutral-200">
              <td class="py-4 font-medium text-neutral-600">Operating Pressure</td>
              <td class="py-4 font-semibold">[Insert Pressure]</td>
            </tr>
            <tr class="border-b border-neutral-200">
              <td class="py-4 font-medium text-neutral-600">Dimensions (L x W x H)</td>
              <td class="py-4 font-semibold">[Insert Dimensions]</td>
            </tr>
            <tr class="border-b border-neutral-200">
              <td class="py-4 font-medium text-neutral-600">Weight (KG)</td>
              <td class="py-4 font-semibold">[Insert Weight]</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- OPERATIONS, INSTALLATION & MAINTENANCE -->
  <section class="w-full bg-zinc-950 text-white px-8 md:px-12 lg:px-16 xl:px-20 py-20">
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-16">
      <div>
        <h2 class="text-2xl font-bold tracking-tight mb-6">Installation & Utilities</h2>
        <ul class="space-y-4 text-neutral-400">
          <li class="flex items-start gap-3">
            <span class="text-blue-500 mt-1">✦</span>
            <span><strong>Power:</strong> [Insert Phase/Voltage requirements]</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-blue-500 mt-1">✦</span>
            <span><strong>Steam/Air:</strong> [Insert compressed air or steam requirements]</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-blue-500 mt-1">✦</span>
            <span><strong>Footprint:</strong> [Insert required clearance space]</span>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold tracking-tight mb-6">Maintenance & Support</h2>
        <p class="text-neutral-400 leading-relaxed mb-6">
          Designed for minimal maintenance. Routine checks include [Insert routine maintenance]. Supported by Gartech Global's pan-India service network ensuring zero operational downtime.
        </p>
        <a href="/contact" class="inline-flex items-center gap-2 text-sm font-semibold text-blue-400 hover:text-blue-300">
          Contact Support Team <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="w-full bg-[#F4F4F5] px-8 md:px-12 lg:px-16 xl:px-20 py-20">
    <div class="w-full lg:w-3/4 mx-auto">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-950 mb-10 text-center">Frequently Asked Questions</h2>
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200/60">
          <h3 class="text-lg font-semibold text-zinc-950 mb-2">What industries is this steam press best suited for?</h3>
          <p class="text-neutral-600">Ideal for commercial laundries, hotels, hospitals, and garment manufacturers requiring high-volume crisp finishing.</p>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-neutral-200/60">
          <h3 class="text-lg font-semibold text-zinc-950 mb-2">Does Gartech provide installation?</h3>
          <p class="text-neutral-600">Yes, our pan-India engineering team handles complete installation, commissioning, and operator training.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>