  <!-- INTERACTIVE TAB FILTER SCRIPT -->
  <script>
    function setupSpecTabs() {
      const buttons = document.querySelectorAll('.spec-tab-btn');
      const rows = document.querySelectorAll('.spec-row');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          // Remove active styles
          buttons.forEach(b => {
            b.classList.remove('bg-zinc-950', 'text-white', 'active');
            b.classList.add('bg-neutral-100', 'text-neutral-600');
          });

          // Set active styles
          btn.classList.add('bg-zinc-950', 'text-white', 'active');
          btn.classList.remove('bg-neutral-100', 'text-neutral-600');

          const target = btn.getAttribute('data-target');

          rows.forEach(row => {
            if (target === 'all' || row.getAttribute('data-category') === target) {
              (row as HTMLElement).style.display = '';
            } else {
              (row as HTMLElement).style.display = 'none';
            }
          });
        });
      });
    }

    setupSpecTabs();
    document.addEventListener('astro:page-load', setupSpecTabs);
  </script>

