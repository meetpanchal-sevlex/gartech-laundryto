    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 hide-scrollbar">
      <button class="spec-tab-btn active px-4 py-2 rounded-full text-xs font-bold tracking-tight transition-all bg-zinc-950 text-white" data-target="all">
        All Machinery (14 Models)
      </button>
      <button class="spec-tab-btn px-4 py-2 rounded-full text-xs font-semibold tracking-tight transition-all bg-neutral-100 text-neutral-600 hover:bg-neutral-200 hover:text-zinc-950" data-target="washers">
        Commercial Washers (20 - 120 KG)
