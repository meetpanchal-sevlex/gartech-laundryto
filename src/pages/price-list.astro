---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Machinery Price List & Technical Specifications | Gartech Global" 
  description="Comprehensive model specifications, capacities, heating options and indicative pricing for Gartech commercial washing machines, industrial dryers, LG stackers, and finishing equipment."
>
  
  <!-- HERO BANNER -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800">
    <div class="max-w-7xl mx-auto">
      
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <span class="text-blue-400">PRICE LIST & SPECIFICATIONS</span>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
            Industrial Equipment Matrix &bull; FY 2026-27
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-white mb-4">
            Machinery Specifications &amp; Price Guide
          </h1>
          <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed">
            Detailed engineering parameters, extraction G-factors, utility connections, and indicative pricing across all Gartech industrial laundry systems.
          </p>
        </div>

        <!-- Quick CTAs -->
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 shrink-0">
          <a href="https://wa.me/919898029292?text=Hello%20Gartech%20Global,%20please%20send%20me%20the%20detailed%20Price%20List%20PDF%20with%20technical%20drawings." target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors shadow-lg shadow-emerald-950/20">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 2C6.5 2 2.012 6.48 2.012 12c0 2.074.634 4.004 1.722 5.613L2.004 22l4.542-1.685A9.957 9.957 0 0 0 12.031 22c5.522 0 10.012-4.48 10.012-10S17.553 2 12.031 2zm5.795 14.282c-.244.686-1.42 1.312-1.956 1.393-.536.082-1.222.115-1.983-.127-.463-.146-1.058-.344-1.825-.678-3.21-1.393-5.297-4.664-5.457-4.88-.16-.217-1.304-1.737-1.304-3.314s.827-2.353 1.12-2.674c.294-.321.642-.401.856-.401.214 0 .428.002.615.011.198.01.463-.075.723.551.268.643.916 2.234.996 2.396.08.16.134.348.027.562-.107.214-.16.348-.321.536-.16.187-.337.417-.481.56-.16.16-.328.334-.141.654.187.32.83 1.369 1.782 2.218 1.224 1.092 2.256 1.43 2.577 1.59.32.16.508.134.695-.08.188-.215.803-.936 1.017-1.257.214-.321.428-.268.722-.16.294.107 1.872.883 2.193 1.044.321.16.536.241.615.375.08.134.08.776-.164 1.462z"/></svg>
            Request Instant Quotation
          </a>
          <a href="/contact#catalogue" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white text-zinc-950 font-bold text-xs hover:bg-neutral-200 transition-colors">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Download PDF Catalog
