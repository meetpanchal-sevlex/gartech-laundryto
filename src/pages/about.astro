---
import Layout from '../layouts/Layout.astro';
import LifecycleShowcase from '../components/LifecycleShowcase.astro';
---
<Layout title="About Gartech Global | Commercial Laundry Machinery Manufacturer" description="Established in 1998, Gartech Global is a premier Indian manufacturer and supplier of commercial and industrial washing machines, dryers, steam presses, and turnkey laundry setups.">

  <!-- HERO SECTION -->
  <section class="relative w-full px-4 sm:px-6 lg:px-8 py-16 md:py-24 overflow-hidden bg-zinc-950 text-white border-b border-zinc-900 industrial-grid-dark">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div class="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] bg-blue-600/20 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-[-20%] right-[-10%] w-[500px] h-[500px] bg-indigo-600/20 blur-[120px] rounded-full"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <span class="text-blue-400">ABOUT GARTECH GLOBAL</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-neutral-200 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        EST. 1998 &bull; ISO 9001:2015 REGISTERED MANUFACTURER
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight mb-6 leading-[1.08]">
        Engineering the <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">Perfect Laundry Workflow.</span>
      </h1>
      <p class="text-base sm:text-xl text-neutral-300 leading-relaxed max-w-3xl">
        Gartech Global isn't just a machinery trader. We are workflow architects and Indian manufacturers delivering 10 KG to 215 KG washing, drying, and finishing systems engineered for 24/7 industrial reliability.
      </p>
    </div>
  </section>

  <!-- METRICS & CORE PHILOSOPHY BENTO -->
  <section class="w-full py-16 md:py-20 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
        
        <div class="md:col-span-2 lg:col-span-2 rounded-2xl bg-white border-t-4 border-t-blue-600 border-x border-b border-neutral-200/90 p-8 shadow-md">
          <span class="inline-block px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 text-xs font-bold font-mono uppercase mb-4">Core Philosophy</span>
          <h2 class="text-2xl sm:text-3xl font-black text-zinc-950 mb-3">Application-Based Engineering</h2>
          <p class="text-sm sm:text-base text-neutral-600 leading-relaxed">
            We reject generic one-size-fits-all catalogs. Our engineers analyze your daily linen load, fabric composition, utility constraints (steam vs electric vs gas), and floor footprint to build an end-to-end automated workflow.
          </p>
        </div>

        <div class="rounded-2xl bg-white border-t-4 border-t-emerald-600 border-x border-b border-neutral-200/90 p-8 flex flex-col justify-center items-center text-center shadow-md">
          <p class="text-5xl font-black text-emerald-600 font-mono mb-2">215<span class="text-2xl">KG</span></p>
          <p class="text-xs font-bold text-neutral-600 uppercase tracking-widest">Max Single Unit Capacity</p>
        </div>

        <div class="rounded-2xl bg-white border-t-4 border-t-amber-500 border-x border-b border-neutral-200/90 p-8 flex flex-col justify-center items-center text-center shadow-md">
          <p class="text-5xl font-black text-amber-500 font-mono mb-2">1,200<span class="text-3xl">+</span></p>
          <p class="text-xs font-bold text-neutral-600 uppercase tracking-widest">Pan-India Installations</p>
        </div>

        <div class="md:col-span-3 lg:col-span-4 rounded-2xl bg-white border border-neutral-200/90 p-7 shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="flex items-center gap-5">
            <div class="w-14 h-14 rounded-2xl bg-zinc-950 text-white flex items-center justify-center shrink-0">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-extrabold text-zinc-950">GIDC Industrial Manufacturing &amp; Pan-India Service</h3>
              <p class="text-sm text-neutral-600 mt-1">Plot No. 48, GIDC Industrial Estate, Phase II, Gujarat &bull; Direct 24-48 hr engineer dispatch to all major Indian cities.</p>
            </div>
          </div>
          <a href="/contact" class="px-6 py-3 rounded-full bg-zinc-950 text-white text-xs font-bold hover:bg-neutral-800 transition-colors shrink-0">
            Schedule Plant Visit &rarr;
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- LIFECYCLE SUPPORT SHOWCASE (Zero-JS Framework Overhead) -->
  <section class="w-full py-16 md:py-24 bg-[#E6E9EE] dot-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="px-2.5 py-1 rounded-md bg-blue-100 text-blue-800 text-xs font-bold font-mono uppercase">Support Infrastructure</span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-zinc-950 mt-2 mb-3">
          Machinery Support Beyond the Sale
        </h2>
        <p class="text-neutral-600 text-sm sm:text-base">
          Explore our 4-stage lifecycle protocol from civil installation to preventive spares maintenance.
        </p>
      </div>

      <LifecycleShowcase />
    </div>
  </section>

</Layout>
