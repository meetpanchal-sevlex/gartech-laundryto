---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact & Factory Works | Gartech Global" description="Get in touch with Gartech Global for commercial and industrial laundry machinery. Request quotations, factory visits, technical sizing, and pan-India service support.">

  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    
    <!-- Top Breadcrumb & Heading -->
    <div class="mb-12">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-4">
        <a href="/" class="hover:text-zinc-950 transition-colors">HOME</a>
        <span>/</span>
        <span class="text-blue-600">CONTACT &amp; PLANT LOCATIONS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-zinc-950 mb-3">
        Let's Engineer Your Laundry Facility
      </h1>
      <p class="text-neutral-500 text-base md:text-lg max-w-2xl leading-relaxed">
        Speak directly with our senior application engineers. We formulate complete machinery schedules, CAD utility drawings, and transparent CIF quotes.
      </p>
    </div>

    <!-- MAIN TWO-COLUMN LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start mb-16">

      <!-- Left 5 Cols: Contact Details & Factory Info (Shaikh Petroleum Model) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Direct Hotline Card -->
        <div class="p-6 bg-zinc-950 text-white rounded-2xl border border-zinc-800 shadow-lg">
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Sales &amp; Tech Hotline
            </span>
            <span class="text-xs text-neutral-400 font-mono">MON - SAT 9AM - 7PM</span>
          </div>
          <p class="text-xs text-neutral-400 uppercase tracking-wider mb-1">Direct Calling</p>
          <a href="tel:+919898029292" class="text-2xl font-black text-white hover:text-blue-400 transition-colors block mb-1">
            +91 98980 29292
          </a>
          <p class="text-xs text-neutral-400 mb-6">Secondary: +91 98989 70097 &bull; WhatsApp active 24/7</p>

          <div class="grid grid-cols-2 gap-3 pt-4 border-t border-zinc-800">
            <a href="https://wa.me/919898029292?text=Hello%20Gartech%20Global,%20I%20am%20interested%20in%20industrial%20laundry%20machinery." target="_blank" rel="noopener noreferrer" class="py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold text-center flex items-center justify-center gap-1.5 transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 2C6.5 2 2.012 6.48 2.012 12c0 2.074.634 4.004 1.722 5.613L2.004 22l4.542-1.685A9.957 9.957 0 0 0 12.031 22c5.522 0 10.012-4.48 10.012-10S17.553 2 12.031 2zm5.795 14.282c-.244.686-1.42 1.312-1.956 1.393-.536.082-1.222.115-1.983-.127-.463-.146-1.058-.344-1.825-.678-3.21-1.393-5.297-4.664-5.457-4.88-.16-.217-1.304-1.737-1.304-3.314s.827-2.353 1.12-2.674c.294-.321.642-.401.856-.401.214 0 .428.002.615.011.198.01.463-.075.723.551.268.643.916 2.234.996 2.396.08.16.134.348.027.562-.107.214-.16.348-.321.536-.16.187-.337.417-.481.56-.16.16-.328.334-.141.654.187.32.83 1.369 1.782 2.218 1.224 1.092 2.256 1.43 2.577 1.59.32.16.508.134.695-.08.188-.215.803-.936 1.017-1.257.214-.321.428-.268.722-.16.294.107 1.872.883 2.193 1.044.321.16.536.241.615.375.08.134.08.776-.164 1.462z"/></svg>
              WhatsApp Us
            </a>
            <a href="mailto:sales@gartechglobal.com" class="py-2.5 px-3 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-semibold text-center flex items-center justify-center gap-1.5 transition-colors">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Email RFP
            </a>
          </div>
        </div>

        <!-- Factory & Works Address -->
        <div class="p-6 bg-white rounded-2xl border border-neutral-200/80 shadow-xs">
          <span class="inline-block px-2 py-0.5 rounded-sm bg-neutral-100 text-neutral-700 font-mono text-[10px] uppercase font-bold mb-2">Main Plant &amp; Works</span>
          <h3 class="font-bold text-base text-zinc-950 mb-2">Gujarat Manufacturing Plant</h3>
          <p class="text-xs text-neutral-600 leading-relaxed mb-4">
            Plot No. 48, GIDC Industrial Estate, Phase II, Ahmedabad / Ankleshwar Corridor, Gujarat – 382445, India
          </p>
          <div class="pt-3 border-t border-neutral-100 text-xs text-neutral-500 space-y-1">
            <p><strong>Visitor Facilities:</strong> Machine live trial center &amp; sample wash laboratory.</p>
            <p><strong>Logistics:</strong> Container stuffing dock &amp; pan-India transport loading.</p>
          </div>
        </div>

        <!-- Regional Depots -->
        <div class="p-6 bg-white rounded-2xl border border-neutral-200/80 shadow-xs">
          <span class="inline-block px-2 py-0.5 rounded-sm bg-neutral-100 text-neutral-700 font-mono text-[10px] uppercase font-bold mb-2">Spares &amp; Field Support</span>
          <h3 class="font-bold text-base text-zinc-950 mb-2">Pan-India Service Network</h3>
          <ul class="text-xs text-neutral-600 space-y-2 mt-3">
            <li class="flex items-center justify-between">
              <span><strong>West India:</strong> Mumbai, Pune, Surat, Ahmedabad</span>
              <span class="text-emerald-600 font-bold text-[11px]">24 Hr Dispatch</span>
            </li>
            <li class="flex items-center justify-between">
              <span><strong>North India:</strong> Delhi NCR, Jaipur, Chandigarh</span>
              <span class="text-emerald-600 font-bold text-[11px]">24 Hr Dispatch</span>
            </li>
            <li class="flex items-center justify-between">
              <span><strong>South India:</strong> Bengaluru, Hyderabad, Chennai, Kochi</span>
              <span class="text-emerald-600 font-bold text-[11px]">48 Hr Dispatch</span>
            </li>
            <li class="flex items-center justify-between">
              <span><strong>East India:</strong> Kolkata, Bhubaneswar</span>
              <span class="text-emerald-600 font-bold text-[11px]">48 Hr Dispatch</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Right 7 Cols: Quotation Request Form -->
      <div class="lg:col-span-7 bg-white rounded-3xl border border-neutral-200/80 shadow-sm p-6 sm:p-10">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-zinc-950">Request Quotation &amp; Sizing</h2>
            <p class="text-xs text-neutral-500 mt-0.5">Fill out your facility parameters for an exact capacity calculation and pricing.</p>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold font-mono">
            RFQ Form
          </span>
        </div>

        <form id="quote-form" class="space-y-4">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Your Name *</label>
              <input type="text" id="form-name" required placeholder="e.g. Rajesh Sharma" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all" />
            </div>
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Company / Facility Name</label>
              <input type="text" id="form-company" placeholder="e.g. Grand Horizon Hotel / CleanPro" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Mobile Number (WhatsApp) *</label>
              <input type="tel" id="form-phone" required placeholder="+91 98000 00000" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all" />
            </div>
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Email Address</label>
              <input type="email" id="form-email" placeholder="name@company.com" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">City &amp; State *</label>
              <input type="text" id="form-city" required placeholder="e.g. Ahmedabad, Gujarat" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white transition-all" />
            </div>
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Industry Sector</label>
              <select id="form-sector" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 text-neutral-800 transition-all">
                <option value="Hotel / Resort">Hotel / Resort / Hospitality</option>
                <option value="Hospital / Healthcare">Hospital / Healthcare / Cleanroom</option>
                <option value="Commercial Laundromat">Commercial Laundromat / Dry Cleaner</option>
                <option value="Garment Manufacturer">Garment Manufacturer / Processing</option>
                <option value="Institutional / Hostel">Educational Institution / Hostel</option>
                <option value="Other">Other Industrial Facility</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Equipment Required</label>
              <select id="form-machine" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 text-neutral-800 transition-all">
                <option value="Commercial Washers">Commercial Washer Extractors (20 - 120 KG)</option>
                <option value="Industrial Dryers">Industrial Tumble Dryers (15 - 100 KG)</option>
                <option value="LG Stackers">LG Commercial Stacker Towers (10 &bull; 15 KG)</option>
                <option value="Hydra Barrier">Hydra Barrier Washers (Cleanroom / Pharma)</option>
                <option value="Steam Press / Alpha">Steam Press Model Alpha / Vacuum Table</option>
                <option value="Flatwork Ironer">Flatwork Bed Sheet Ironer</option>
                <option value="Complete Setup">Complete Turnkey Laundry Plant Setup</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Estimated Daily Volume</label>
              <select id="form-volume" class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 text-neutral-800 transition-all">
                <option value="Below 100 KG/day">Below 100 KG / Day</option>
                <option value="100 - 300 KG/day">100 to 300 KG / Day</option>
                <option value="300 - 800 KG/day">300 to 800 KG / Day</option>
                <option value="800 - 2,000 KG/day">800 to 2,000 KG / Day</option>
                <option value="Above 2,000 KG/day">Mass Scale (&gt; 2,000 KG / Day)</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-zinc-900 mb-1.5 uppercase tracking-wider">Project Notes / Specific Model Requirements</label>
            <textarea id="form-message" rows="3" placeholder="Mention available space, utility type (Steam boiler vs Electric heater), timeline for setup..." class="w-full px-4 py-3 rounded-xl border border-neutral-200 bg-neutral-50 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:bg-white resize-none transition-all"></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" class="w-full py-4 text-sm font-bold text-white bg-zinc-950 hover:bg-blue-600 rounded-full transition-all shadow-md active:scale-98 flex items-center justify-center gap-2">
              <span>Submit RFQ &amp; Request Official Quotation</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>

          <div id="form-status" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium text-center"></div>

          <p class="text-[11px] text-neutral-400 text-center">
            &bull; Guaranteed quotation within 24 hours &bull; Strict privacy &bull; Direct factory pricing with GST input tax credit
          </p>
        </form>
      </div>

    </div>

  </section>

  <!-- FORM SCRIPT WITH DIRECT WHATSAPP FALLBACK -->
  <script>
    function setupContactForm() {
      const form = document.getElementById('quote-form') as HTMLFormElement | null;
      const status = document.getElementById('form-status');
      if (!form) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const name = (document.getElementById('form-name') as HTMLInputElement)?.value || '';
        const company = (document.getElementById('form-company') as HTMLInputElement)?.value || '';
        const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value || '';
        const city = (document.getElementById('form-city') as HTMLInputElement)?.value || '';
        const machine = (document.getElementById('form-machine') as HTMLSelectElement)?.value || '';
        const volume = (document.getElementById('form-volume') as HTMLSelectElement)?.value || '';
        const message = (document.getElementById('form-message') as HTMLTextAreaElement)?.value || '';

        const text = `*New Machinery Quotation Request*\n\n*Name:* ${name}\n*Company:* ${company}\n*Phone:* ${phone}\n*City:* ${city}\n*Machine:* ${machine}\n*Daily Volume:* ${volume}\n*Notes:* ${message}`;

        if (status) {
          status.classList.remove('hidden');
          status.innerHTML = `<strong>Thank you, ${name}!</strong> Your quotation request has been logged. An application engineer is preparing your technical schedule.<br/><br/><a href="https://wa.me/919898029292?text=${encodeURIComponent(text)}" target="_blank" class="inline-block mt-2 px-4 py-2 bg-emerald-600 text-white rounded-lg font-bold text-xs">Click here to send directly to WhatsApp Sales &rarr;</a>`;
        }

        form.reset();
      });
    }

    setupContactForm();
    document.addEventListener('astro:page-load', setupContactForm);
  </script>

</Layout>
