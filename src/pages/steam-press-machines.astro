---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Steam Press Machines | Industrial Steam Pressing | Gartech Global" description="Professional steam press machines for commercial laundries, dry cleaners, and hotels. Industrial-grade steam pressing and garment finishing equipment from Gartech Global.">

  <!-- Hero -->
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="max-w-3xl">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-zinc-950 transition-colors mb-8">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 11L5 7L9 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Home
      </a>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-6">
        Garment Finishing Equipment
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.03em] leading-[1.1] mb-6">
        Steam Press Machines
      </h1>
      <p class="text-lg md:text-xl text-neutral-500 leading-relaxed mb-8">
        Professional garment finishing for commercial laundries, dry cleaners, hotels and institutions. Gartech Global provides industrial-grade steam pressing solutions that improve garment presentation, finishing consistency and processing productivity.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-zinc-950 rounded-full hover:bg-zinc-800 transition-all hover:-translate-y-0.5 duration-150">
          Request a Quote
        </a>
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-zinc-950 bg-white border border-neutral-200 rounded-full hover:border-neutral-300 hover:bg-neutral-50 transition-all hover:-translate-y-0.5 duration-150">
          Download Spec Sheet
        </a>
      </div>
    </div>
  </section>

  <!-- Why Finishing Matters -->
  <section class="bg-white border-y border-neutral-200/80 py-16">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold tracking-tight mb-4">Why Garment Finishing Matters</h2>
          <p class="text-neutral-500 text-lg leading-relaxed mb-8">
            A professional laundry does not end with washing and drying. Garment finishing determines the final appearance of the product delivered to the customer. The right steam pressing equipment transforms the quality of your output.
          </p>
          <div class="grid grid-cols-2 gap-4">
            {[
              "Garment presentation",
              "Customer experience",
              "Finishing consistency",
              "Processing productivity",
              "Professional appearance",
              "Business reputation",
            ].map((item) => (
              <div class="flex items-center gap-2.5">
                <div class="w-5 h-5 rounded-full bg-zinc-950 flex items-center justify-center shrink-0">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M2 5l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <span class="text-sm font-medium text-neutral-700">{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-neutral-50 rounded-3xl border border-neutral-200/60 p-10 flex items-center justify-center min-h-64">
          <div class="text-center">
            <div class="w-20 h-20 bg-white rounded-2xl card-shadow mx-auto mb-4 flex items-center justify-center">
              <svg width="36" height="36" viewBox="0 0 36 36" fill="none"><rect x="6" y="4" width="24" height="20" rx="3" stroke="#18181b" stroke-width="2"/><path d="M6 16h24" stroke="#18181b" stroke-width="1.5" opacity="0.3"/><path d="M10 26l3 6h10l3-6" stroke="#18181b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/></svg>
            </div>
            <p class="font-semibold text-zinc-950">Steam Press</p>
            <p class="text-neutral-500 text-sm mt-1">Professional Finishing Equipment</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products - Coming Soon Grid -->
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10">
      <h2 class="text-3xl font-bold tracking-tight mb-3">Steam Press Machine Range</h2>
      <p class="text-neutral-500 text-lg">Detailed specifications for each model are being updated. Contact us for immediate pricing and availability.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {["Steam Press Model 1", "Steam Press Model 2", "Steam Press Model 3", "Steam Press Model 4"].map((model, i) => (
        <div class="relative bg-white rounded-3xl border border-neutral-200/80 card-shadow p-8 flex flex-col justify-between min-h-64 overflow-hidden group hover:-translate-y-1 transition-all duration-300">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-4">
              Professional Steam Press
            </div>
            <h3 class="text-xl font-bold tracking-tight mb-2">{model}</h3>
            <p class="text-neutral-500 text-sm">Specifications are currently being updated. Contact our team for technical details and pricing.</p>
          </div>
          <a href="/steam-press-machines/model-alpha" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-blue-600 group-hover:gap-3 transition-all">
            View Full Details & Specs
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="absolute top-0 right-0 w-24 h-24 bg-neutral-50 rounded-bl-[48px] -translate-y-0 translate-x-0"></div>
        </div>
      ))}
    </div>
  </section>

  <!-- Industries using Steam Press -->
  <section class="bg-white border-y border-neutral-200/80 py-16">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight mb-8">Who Uses Our Steam Press Machines?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { title: "Commercial Laundries", desc: "High-volume pressing for customer garments, uniforms, and linens." },
          { title: "Hotels & Resorts", desc: "Precise finishing for guest garments, staff uniforms, and bed linens." },
          { title: "Dry Cleaners", desc: "Professional garment pressing and finishing for customer clothing care." },
          { title: "Hospitals", desc: "Steam pressing for institutional textiles and staff uniforms." },
          { title: "Garment Manufacturers", desc: "Final pressing and finishing for production garments." },
          { title: "Institutions", desc: "Schools, hostels and large organizations requiring uniform finishing." },
        ].map((item) => (
          <div class="p-6 bg-neutral-50 rounded-2xl border border-neutral-200/60 hover:bg-white hover:card-shadow transition-all duration-200">
            <h3 class="font-semibold text-zinc-950 mb-2">{item.title}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-zinc-950 text-white rounded-3xl p-10 md:p-14 relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(255,255,255,0.05)_0%,transparent_70%)]"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight mb-4">Looking for a Steam Press Machine?</h2>
        <p class="text-neutral-400 text-lg mb-8">Tell us your business type, daily volume and finishing requirements. Our team will recommend the right steam press solution for your operation.</p>
        <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all hover:-translate-y-0.5 duration-150">
          Talk to Our Team
        </a>
      </div>
    </div>
  </section>

</Layout>
