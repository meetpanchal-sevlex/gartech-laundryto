---
import Layout from "../../layouts/Layout.astro";
const models = [
  { sku: "LG-Titan-10", cap: "10 KG + 10 KG", drive: "Inverter DirectDrive", spin: "1,150 RPM (400 G)", heat: "Electric 230V Single Phase", pay: "UPI / Coin / Card Ready", price: "₹ 3,45,000*" },
  { sku: "LG-Giant-15", cap: "15 KG + 15 KG", drive: "Heavy Inverter DD", spin: "1,050 RPM (350 G)", heat: "Electric / Piped Gas", pay: "UPI / Token / Smart App", price: "₹ 4,75,000*" }
];
---
<Layout title="LG Commercial Stackers | 10 KG & 15 KG | Gartech Global" description="Space-saving LG Commercial Washer-Dryer Stacker Towers for laundromats, hostels, resorts, and commercial setups.">

  <!-- DARK HERO -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 industrial-grid-dark">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <a href="/machinery" class="hover:text-white transition-colors">MACHINERY</a>
        <span>/</span>
        <span class="text-indigo-400">LG COMMERCIAL STACKERS</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Compact Vertical Towers &bull; 50% Floor Space Saved
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4">LG Commercial Stacker Towers</h1>
      <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed mb-8">
        Double your revenue per square foot. Stacked washer + dryer towers with Inverter DirectDrive motors, whisper-quiet &lt;58 dB operation, and instant UPI / Coin payment integration.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact?category=stackers" class="px-7 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request Price Quote</a>
        <a href="/price-list" class="px-7 py-3.5 text-sm font-semibold text-white bg-white/10 border border-white/15 rounded-full hover:bg-white/15 transition-all">Full Price Matrix</a>
      </div>
    </div>
  </section>

  <!-- MODELS -->
  <section class="w-full py-16 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {models.map((m) => (
          <div class="bg-white rounded-2xl border-t-4 border-t-indigo-600 border-x border-b border-neutral-200 p-8 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded-md text-xs font-extrabold bg-indigo-50 text-indigo-700 border border-indigo-200">{m.cap}</span>
                <span class="font-mono text-xs text-neutral-400 font-bold">{m.sku}</span>
              </div>
              <h2 class="text-2xl font-black text-zinc-950 mb-2">{m.sku.replace(/-/g, ' ')} Tower</h2>
              <p class="text-sm text-neutral-600 mb-5">Plug-and-play commercial stacker requiring zero bolting on upper floors. Features Atomizing Twin-Spray rinse and automatic drum tub clean.</p>
              <div class="bg-neutral-100/80 border border-neutral-200 rounded-xl p-4 text-xs font-mono text-neutral-700 space-y-1 mb-6">
                <p>&bull; Motor: {m.drive}</p>
                <p>&bull; Extraction: {m.spin}</p>
                <p>&bull; Utility: {m.heat}</p>
                <p>&bull; Automation: {m.pay}</p>
              </div>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-neutral-100">
              <span class="font-mono font-bold text-sm text-zinc-950">Base: {m.price}</span>
              <a href={`/contact?model=${m.sku}`} class="px-5 py-2.5 rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-indigo-600 transition-colors">Get Official Quote &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-zinc-950 text-white px-4 sm:px-6 lg:px-8 py-16 text-center industrial-grid-dark">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black mb-3">Launching a Laundromat or Hostel Laundry?</h2>
      <p class="text-neutral-400 text-sm mb-6">Get a complete ROI calculation, UPI payment setup guide, and floor plan layout from Gartech.</p>
      <a href="/contact?category=stackers" class="inline-block px-8 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request Laundromat Business Plan</a>
    </div>
  </section>

</Layout>
