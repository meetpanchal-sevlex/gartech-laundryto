---
import Layout from "../../layouts/Layout.astro";
const models = ["10 KG", "15 KG"];
---
<Layout title="LG Commercial Stackers | 10 KG and 15 KG | Gartech Global">
  <section class="w-full px-8 md:px-12 lg:px-16 xl:px-20 mx-auto py-16 md:py-24">
    <div class="max-w-3xl mb-14">
      <div class="flex items-center gap-2 mb-8">
        <a href="/" class="text-sm text-neutral-500 hover:text-zinc-950 transition-colors">Home</a>
        <span class="text-neutral-300">/</span>
        <a href="/machinery" class="text-sm text-neutral-500 hover:text-zinc-950 transition-colors">Machinery</a>
        <span class="text-neutral-300">/</span>
        <span class="text-sm text-zinc-950">LG Commercial Stackers</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 border border-blue-100 text-blue-700 mb-6">LG Commercial</div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.1] mb-4">LG Commercial Stackers</h1>
      <p class="text-lg text-neutral-500 leading-relaxed mb-8">Space-saving stacked washer-dryer combinations for compact commercial operations. Available in 10 KG and 15 KG capacities.</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-zinc-950 rounded-full hover:bg-zinc-800 transition-all hover:-translate-y-0.5">Request a Quote</a>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      {models.map((cap) => (
        <div class="bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:-translate-y-1 transition-all p-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 border border-blue-100 text-blue-700 mb-4">{cap} Model</div>
          <h2 class="text-2xl font-bold tracking-tight mb-3">LG Commercial Stacker {cap}</h2>
          <p class="text-neutral-500 mb-6">Compact, reliable and energy-efficient. Contact us for full specifications and pricing.</p>
          <a href="/contact" class="inline-flex items-center gap-2 text-sm font-semibold text-zinc-950">Request Specifications &rarr;</a>
        </div>
      ))}
    </div>
    <div class="bg-zinc-950 text-white rounded-3xl p-10 md:p-14">
      <h2 class="text-2xl font-bold tracking-tight mb-3">Interested in LG Commercial Stackers?</h2>
      <p class="text-neutral-400 mb-8">Contact us for pricing, specs and availability.</p>
      <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all">Talk to Our Team</a>
    </div>
  </section>
</Layout>