---
import Layout from "../../layouts/Layout.astro";
const capacities = ["20 KG", "30 KG", "50 KG", "60 KG"];
---
<Layout title="Commercial Washing Machines | 20 to 60 KG | Gartech Global">
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="max-w-3xl mb-14">
      <div class="flex items-center gap-2 mb-8">
        <a href="/" class="text-sm text-neutral-500 hover:text-zinc-950">Home</a>
        <span class="text-neutral-300">/</span>
        <a href="/machinery" class="text-sm text-neutral-500 hover:text-zinc-950">Machinery</a>
        <span class="text-neutral-300">/</span>
        <span class="text-sm text-zinc-950">Commercial Washing Machines</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-6">Commercial Range</div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.1] mb-4">Commercial Washing Machines</h1>
      <p class="text-lg text-neutral-500 leading-relaxed mb-8">High-extraction commercial washer-extractors built for 24/7 operations. Available in 20 KG, 30 KG, 50 KG and 60 KG capacities for hotels, hospitals, dry cleaners and laundry businesses.</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-zinc-950 rounded-full hover:bg-zinc-800 transition-all hover:-translate-y-0.5">Request a Quote</a>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      {capacities.map((cap) => (
        <div class="bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:-translate-y-1 transition-all p-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-4">{cap}</div>
          <h2 class="text-2xl font-bold tracking-tight mb-3">Commercial Washer Extractor {cap}</h2>
          <p class="text-neutral-500 mb-6">Professional commercial washing machine built for hotels, hospitals and commercial laundry operations. Contact us for full technical specifications.</p>
          <a href="/contact" class="inline-flex items-center gap-2 text-sm font-semibold text-zinc-950">Request Specifications &rarr;</a>
        </div>
      ))}
    </div>
    <div class="bg-zinc-950 text-white rounded-3xl p-10 md:p-14">
      <h2 class="text-2xl font-bold tracking-tight mb-3">Choosing the Right Washing Machine?</h2>
      <p class="text-neutral-400 mb-8">Your daily volume determines which capacity is right. Our team will guide you to the right choice.</p>
      <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all">Talk to Our Team</a>
    </div>
  </section>
</Layout>