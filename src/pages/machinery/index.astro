---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Laundry Machinery | Commercial & Industrial Machines | Gartech Global" description="Complete range of commercial and industrial laundry machinery. LG commercial stackers, washing machines, dryers and Hydra industrial laundry equipment from Gartech Global.">

  <section class="max-w-7xl mx-auto px-4 md:px-8 py-16 md:py-24">
    <div class="max-w-3xl mb-14">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-zinc-950 transition-colors mb-8">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 11L5 7L9 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Home
      </a>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-6">
        Full Range
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.1] mb-4">Laundry Machinery</h1>
      <p class="text-lg text-neutral-500 leading-relaxed">The complete Gartech Global machinery range — from compact commercial stackers to large-scale industrial laundry equipment.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- LG Stackers -->
      <a href="/machinery/lg-commercial-stackers" class="group bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover transition-all duration-300 hover:-translate-y-1 overflow-hidden">
        <div class="p-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 border border-blue-100 text-blue-700 mb-5">LG Commercial</div>
          <h2 class="text-2xl font-bold tracking-tight mb-3">LG Commercial Stackers</h2>
          <p class="text-neutral-500 mb-5 leading-relaxed">Space-saving stacked washer-dryer combinations designed for compact commercial operations. Reliable, energy-efficient and built for daily commercial use.</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {["10 KG", "15 KG"].map(cap => (
              <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded-full border border-neutral-200/60">{cap}</span>
            ))}
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 group-hover:gap-2.5 transition-all">
            View LG Stackers <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Washing Machines -->
      <a href="/machinery/commercial-washing-machines" class="group bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover transition-all duration-300 hover:-translate-y-1 overflow-hidden">
        <div class="p-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-5">Commercial</div>
          <h2 class="text-2xl font-bold tracking-tight mb-3">Commercial Washing Machines</h2>
          <p class="text-neutral-500 mb-5 leading-relaxed">High-extraction commercial washer-extractors built for 24/7 operations. Suitable for hotels, hospitals, dry cleaners and laundry businesses of all sizes.</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {["20 KG", "30 KG", "50 KG", "60 KG"].map(cap => (
              <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded-full border border-neutral-200/60">{cap}</span>
            ))}
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 group-hover:gap-2.5 transition-all">
            View Washers <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Dryers -->
      <a href="/machinery/commercial-laundry-dryers" class="group bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover transition-all duration-300 hover:-translate-y-1 overflow-hidden">
        <div class="p-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-neutral-100 border border-neutral-200/60 text-neutral-700 mb-5">Commercial</div>
          <h2 class="text-2xl font-bold tracking-tight mb-3">Commercial Laundry Dryers</h2>
          <p class="text-neutral-500 mb-5 leading-relaxed">Energy-efficient tumble dryers for high-volume commercial operations. Matched dryer capacities to pair with your washing machines for an efficient laundry workflow.</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {["20 KG", "30 KG", "50 KG", "60 KG"].map(cap => (
              <span class="px-3 py-1 bg-neutral-100 text-neutral-700 text-xs font-medium rounded-full border border-neutral-200/60">{cap}</span>
            ))}
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 group-hover:gap-2.5 transition-all">
            View Dryers <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

      <!-- Hydra Industrial -->
      <a href="/machinery/hydra-industrial-laundry-machinery" class="group bg-zinc-950 text-white rounded-3xl border border-zinc-800 card-shadow hover:card-shadow-hover transition-all duration-300 hover:-translate-y-1 overflow-hidden">
        <div class="p-8">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-white/10 border border-white/10 text-neutral-300 mb-5">Industrial Scale</div>
          <h2 class="text-2xl font-bold tracking-tight mb-3">Hydra Industrial Laundry</h2>
          <p class="text-neutral-400 mb-5 leading-relaxed">Heavy-duty industrial laundry machinery for large-scale operations. Designed for institutional laundries, garment manufacturers and high-volume commercial facilities.</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {["30 KG", "50 KG", "100 KG", "150 KG", "215 KG"].map(cap => (
              <span class="px-3 py-1 bg-white/10 text-neutral-300 text-xs font-medium rounded-full border border-white/10">{cap}</span>
            ))}
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-white group-hover:gap-2.5 transition-all">
            View Industrial Range <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>

    </div>
  </section>

  <!-- Setup Guide CTA -->
  <section class="max-w-7xl mx-auto px-4 md:px-8 pb-20">
    <div class="bg-neutral-50 border border-neutral-200/80 rounded-3xl p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight mb-2">Not sure which machines you need?</h2>
        <p class="text-neutral-500">Our team will help you plan the right laundry setup based on your daily volume, space, and business requirements.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="/setup" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-zinc-950 bg-white border border-neutral-200 rounded-full hover:border-neutral-300 transition-all hover:-translate-y-0.5 duration-150">Laundry Setup Guide</a>
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-zinc-950 rounded-full hover:bg-zinc-800 transition-all hover:-translate-y-0.5 duration-150">Request a Quote</a>
      </div>
    </div>
  </section>

</Layout>
