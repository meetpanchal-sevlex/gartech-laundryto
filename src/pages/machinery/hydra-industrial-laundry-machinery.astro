---
import Layout from "../../layouts/Layout.astro";
const models = [
  { sku: "HCB-60", cap: "60 KG", vol: "600 L", design: "Dual-Door Pass-Through", std: "NABH / WHO Cleanroom", power: "7.5 kW VFD PLC", price: "₹ 9,50,000*" },
  { sku: "HCB-120", cap: "120 KG", vol: "1,200 L", design: "Pneumatic Suspension Barrier", std: "Pharma & Hospital Grade", power: "15.0 kW VFD Touch", price: "₹ 14,80,000*" },
  { sku: "HCB-215", cap: "215 KG", vol: "2,150 L", design: "Auto-Tilting Mega Barrier", std: "Mass Central Laundry Plant", power: "22.0 kW Heavy Duty", price: "₹ 21,50,000*" }
];
---
<Layout title="Hydra Industrial Barrier Washers | 60 to 215 KG | Gartech Global" description="Dual-door hygienic barrier washers from 60 KG to 215 KG for hospitals, pharmaceutical cleanrooms, and central laundry facilities.">

  <!-- DARK HERO -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 industrial-grid-dark">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <a href="/machinery" class="hover:text-white transition-colors">MACHINERY</a>
        <span>/</span>
        <span class="text-emerald-400">HYDRA BARRIER WASHERS</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        60 KG to 215 KG &bull; Cleanroom Isolation
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4">Hydra Industrial Barrier Washers</h1>
      <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed mb-8">
        Engineered for zero cross-contamination. Mounted across a clean/dirty partition wall so soiled hospital or pharma garments never contact sanitized linen.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact?category=hydra" class="px-7 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request Price Quote</a>
        <a href="/price-list" class="px-7 py-3.5 text-sm font-semibold text-white bg-white/10 border border-white/15 rounded-full hover:bg-white/15 transition-all">Full Price Matrix</a>
      </div>
    </div>
  </section>

  <!-- MODELS -->
  <section class="w-full py-16 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {models.map((m) => (
          <div class="bg-white rounded-2xl border-t-4 border-t-emerald-600 border-x border-b border-neutral-200 p-7 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded-md text-xs font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200">{m.cap}</span>
                <span class="font-mono text-xs text-neutral-400 font-bold">{m.sku}</span>
              </div>
              <h2 class="text-xl font-black text-zinc-950 mb-2">Hydra CleanBarrier {m.sku}</h2>
              <p class="text-xs sm:text-sm text-neutral-600 mb-5">Full pneumatic door interlocks with dual-side PLC telemetry, thermal disinfection logging, and automated drum positioning.</p>
              <div class="bg-neutral-100/80 border border-neutral-200 rounded-xl p-4 text-xs font-mono text-neutral-700 space-y-1 mb-6">
                <p>&bull; Volume: {m.vol}</p>
                <p>&bull; Architecture: {m.design}</p>
                <p>&bull; Compliance: {m.std}</p>
                <p>&bull; Power: {m.power}</p>
              </div>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-neutral-100">
              <span class="font-mono font-bold text-sm text-zinc-950">{m.price}</span>
              <a href={`/contact?model=${m.sku}`} class="px-4 py-2 rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-emerald-600 transition-colors">Get Quote &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-zinc-950 text-white px-4 sm:px-6 lg:px-8 py-16 text-center industrial-grid-dark">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black mb-3">Planning a Hospital or Pharma Cleanroom Laundry?</h2>
      <p class="text-neutral-400 text-sm mb-6">Request our partition wall CAD blueprints and NABH compliance documentation.</p>
      <a href="/contact?category=hydra" class="inline-block px-8 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request CAD Partition Drawings</a>
    </div>
  </section>

</Layout>
