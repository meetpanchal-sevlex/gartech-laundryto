---
import Layout from "../../layouts/Layout.astro";
const capacities = ["30 KG", "50 KG", "60 KG", "100 KG", "150 KG", "215 KG"];
---
<Layout title="Hydra Industrial Laundry Machinery | 30 KG to 215 KG | Gartech Global">
  <section class="w-full px-8 md:px-12 lg:px-16 xl:px-20 mx-auto py-16 md:py-24">
    <div class="max-w-3xl mb-14">
      <div class="flex items-center gap-2 mb-8">
        <a href="/" class="text-sm text-neutral-500 hover:text-zinc-950 transition-colors">Home</a>
        <span class="text-neutral-300">/</span>
        <a href="/machinery" class="text-sm text-neutral-500 hover:text-zinc-950 transition-colors">Machinery</a>
        <span class="text-neutral-300">/</span>
        <span class="text-sm text-zinc-950">Hydra Industrial</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-50 border border-amber-100 text-amber-700 mb-6">Industrial Scale</div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.1] mb-4">Hydra Industrial Laundry Machinery</h1>
      <p class="text-lg text-neutral-500 leading-relaxed mb-8">Heavy-duty industrial laundry machines from 30 KG to 215 KG for large-scale operations, institutions and garment manufacturers.</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-zinc-950 rounded-full hover:bg-zinc-800 transition-all hover:-translate-y-0.5 duration-150">Request a Quote</a>
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-zinc-950 bg-white border border-neutral-200 rounded-full hover:bg-neutral-50 transition-all hover:-translate-y-0.5 duration-150">Contact for Specs</a>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
      {capacities.map((cap) => (
        <div class="bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover hover:-translate-y-1 transition-all duration-300 p-7">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-50 border border-amber-100 text-amber-700 mb-4">{cap}</div>
          <h2 class="text-xl font-bold tracking-tight mb-2">Hydra Industrial {cap}</h2>
          <p class="text-neutral-500 text-sm mb-4">Industrial-grade laundry machine for high-volume operations. Contact us for complete specifications.</p>
          <a href="/contact" class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-950 hover:gap-2.5 transition-all">Get Specifications &rarr;</a>
        </div>
      ))}
    </div>
    <div class="bg-zinc-950 text-white rounded-3xl p-10 md:p-14">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight mb-3">Planning an Industrial Laundry?</h2>
        <p class="text-neutral-400 mb-8">Our team will help you select the right Hydra configuration for your daily volume and facility requirements.</p>
        <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold text-zinc-950 bg-white rounded-full hover:bg-neutral-100 transition-all hover:-translate-y-0.5 duration-150">Talk to Our Team</a>
      </div>
    </div>
  </section>
</Layout>