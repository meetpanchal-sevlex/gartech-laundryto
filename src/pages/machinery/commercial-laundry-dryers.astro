---
import Layout from "../../layouts/Layout.astro";
const models = [
  { sku: "GAD-15", cap: "15 KG", vol: "310 L", drum: "Reversing Axial Flow", heat: "Electric / Gas", power: "0.55 kW + 0.37 kW", price: "₹ 1,95,000*" },
  { sku: "GAD-25", cap: "25 KG", vol: "510 L", drum: "Reversing Axial Flow", heat: "Electric / Gas / Steam", power: "0.75 kW + 0.55 kW", price: "₹ 2,40,000*" },
  { sku: "GAD-50", cap: "50 KG", vol: "1,020 L", drum: "Reversing Radial Flow", heat: "Steam / Piped Gas", power: "1.5 kW + 1.1 kW", price: "₹ 3,85,000*" },
  { sku: "GAD-100", cap: "100 KG", vol: "2,050 L", drum: "AISI 304 Heavy Reversing", heat: "Steam (High Pressure)", power: "3.0 kW + 2.2 kW", price: "₹ 6,90,000*" }
];
---
<Layout title="Industrial Tumble Dryers | 15 to 100 KG | Gartech Global" description="Heavy-duty commercial and industrial tumble dryers with reversing stainless drums and steam, gas, or electric heating.">

  <!-- DARK HERO -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 industrial-grid-dark">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <a href="/machinery" class="hover:text-white transition-colors">MACHINERY</a>
        <span>/</span>
        <span class="text-amber-400">INDUSTRIAL TUMBLE DRYERS</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4">
        GAD Series &bull; Rapid Moisture Extraction
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4">Industrial Tumble Dryers</h1>
      <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed mb-8">
        High-efficiency reversing tumble dryers from 15 KG to 100 KG. Engineered with dual thermal insulation and large-area lint screens for fast, uniform drying.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contact?category=dryers" class="px-7 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request Price Quote</a>
        <a href="/price-list" class="px-7 py-3.5 text-sm font-semibold text-white bg-white/10 border border-white/15 rounded-full hover:bg-white/15 transition-all">Full Price Matrix</a>
      </div>
    </div>
  </section>

  <!-- MODELS GRID & SPEC TABLE -->
  <section class="w-full py-16 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {models.map((m) => (
          <div class="bg-white rounded-2xl border-t-4 border-t-amber-500 border-x border-b border-neutral-200 p-7 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded-md text-xs font-extrabold bg-amber-50 text-amber-700 border border-amber-200">{m.cap} Capacity</span>
                <span class="font-mono text-xs text-neutral-400 font-bold">{m.sku}</span>
              </div>
              <h2 class="text-2xl font-black text-zinc-950 mb-2">Gartech AirDry {m.sku}</h2>
              <p class="text-sm text-neutral-600 mb-5">Bi-directional reversing cylinder prevents linen balling, while precision temperature sensors protect delicate hotel and hospital textiles.</p>
              <div class="bg-neutral-100/80 border border-neutral-200 rounded-xl p-4 text-xs font-mono text-neutral-700 space-y-1 mb-6">
                <p>&bull; Drum Volume: {m.vol} (Perforated)</p>
                <p>&bull; Airflow: {m.drum}</p>
                <p>&bull; Heating: {m.heat}</p>
                <p>&bull; Drive + Blower: {m.power}</p>
              </div>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-neutral-100">
              <span class="font-mono font-bold text-sm text-zinc-950">Base: {m.price}</span>
              <a href={`/contact?model=${m.sku}`} class="px-5 py-2.5 rounded-xl bg-zinc-950 text-white text-xs font-bold hover:bg-amber-600 transition-colors">Get Official Quote &rarr;</a>
            </div>
          </div>
        ))}
      </div>

      <!-- Technical Spec Table -->
      <div class="bg-white rounded-2xl border-2 border-neutral-300 shadow-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border-collapse min-w-[700px]">
            <thead class="bg-zinc-950 text-neutral-300 font-mono uppercase text-[10px]">
              <tr>
                <th class="py-4 px-4 text-white">Model</th>
                <th class="py-4 px-4 text-white">Capacity</th>
                <th class="py-4 px-4 text-white">Drum Vol</th>
                <th class="py-4 px-4 text-white">Airflow Spec</th>
                <th class="py-4 px-4 text-white">Heating</th>
                <th class="py-4 px-4 text-white">Power</th>
                <th class="py-4 px-4 text-white text-right">Indicative Rate*</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-200">
              {models.map((m) => (
                <tr class="hover:bg-amber-50/50 transition-colors">
                  <td class="py-3.5 px-4 font-bold text-zinc-950">{m.sku}</td>
                  <td class="py-3.5 px-4 font-bold text-amber-700">{m.cap}</td>
                  <td class="py-3.5 px-4 text-neutral-600">{m.vol}</td>
                  <td class="py-3.5 px-4 text-neutral-600">{m.drum}</td>
                  <td class="py-3.5 px-4 text-neutral-600">{m.heat}</td>
                  <td class="py-3.5 px-4 text-neutral-600">{m.power}</td>
                  <td class="py-3.5 px-4 text-right font-mono font-bold text-zinc-950">{m.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="w-full bg-zinc-950 text-white px-4 sm:px-6 lg:px-8 py-16 text-center industrial-grid-dark">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-black mb-3">Steam, Gas, or Electric Heating?</h2>
      <p class="text-neutral-400 text-sm mb-6">Our engineers calculate the lowest operating cost per KG based on your site's energy tariff.</p>
      <a href="/contact?category=dryers" class="inline-block px-8 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request Utility Cost Analysis</a>
    </div>
  </section>

</Layout>
