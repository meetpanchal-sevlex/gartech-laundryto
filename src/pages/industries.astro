---
import Layout from '../layouts/Layout.astro';
const sectors = [
  { name: "Hotels & Resorts", color: "border-t-blue-600", badge: "bg-blue-50 text-blue-700 border-blue-200", load: "200 - 2,000+ KG/day", equip: "Washers, Reversing Dryers, 3M Flatwork Ironers", desc: "Continuous processing of high-thread-count bed sheets, bath towels, and F&B table linen with 2-hour room turnaround." },
  { name: "Hospitals & Healthcare", color: "border-t-emerald-600", badge: "bg-emerald-50 text-emerald-700 border-emerald-200", load: "300 - 3,000+ KG/day", equip: "Hydra Dual-Door Barrier Washers", desc: "Strict bio-hazard containment between soiled loading and clean sterile unloading zones compliant with NABH & WHO hygiene norms." },
  { name: "Commercial Laundromats", color: "border-t-amber-500", badge: "bg-amber-50 text-amber-700 border-amber-200", load: "100 - 500 KG/day", equip: "LG Commercial Stackers (10/15 KG)", desc: "High-ROI compact vertical washer-dryer towers featuring UPI/Coin payment automation and ultra-quiet DirectDrive motors." },
  { name: "Garment Exporters", color: "border-t-purple-600", badge: "bg-purple-50 text-purple-700 border-purple-200", load: "500 - 5,000+ KG/day", equip: "GHW Heavy Washers, Model Alpha Presses", desc: "Industrial enzyme washing, denim finishing, and high-throughput pneumatic steam pressing for export houses." },
  { name: "Hostels & Institutions", color: "border-t-indigo-600", badge: "bg-indigo-50 text-indigo-700 border-indigo-200", load: "250 - 1,500 KG/day", equip: "LG Stackers & GHW-35 Washers", desc: "Tamper-resistant, heavy-duty student and institutional laundry plants designed for nonstop daily operation." },
  { name: "Dry Cleaners & Chains", color: "border-t-zinc-800", badge: "bg-neutral-100 text-zinc-800 border-neutral-300", load: "80 - 400 KG/day", equip: "Vacuum Tables, Model Alpha, GHW-20", desc: "Precision garment finishing, spotting stations, and soft-mount washers protecting delicate ethnic wear, wool, and silk." }
];
---
<Layout title="Industries We Serve | Commercial & Industrial Laundry | Gartech Global" description="Custom-engineered laundry systems for hotels, hospitals, commercial laundromats, garment exporters, and institutions across India.">

  <!-- DARK HERO -->
  <section class="bg-zinc-950 text-white py-14 md:py-20 px-4 sm:px-6 lg:px-8 border-b border-zinc-800 industrial-grid-dark">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <span class="text-blue-400">INDUSTRIES WE SERVE</span>
      </div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Sector-Engineered Laundry Plants
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight mb-4">Industries Powered by Gartech</h1>
      <p class="text-neutral-400 text-base md:text-lg max-w-2xl leading-relaxed mb-8">
        Every industry faces distinct fabric weights, sanitization standards, and shift cycles. We configure the exact machinery schedule for your sector.
      </p>
      <a href="/contact" class="inline-block px-7 py-3.5 text-sm font-bold text-zinc-950 bg-white rounded-full hover:bg-neutral-200 transition-all">Request Sector Consultation</a>
    </div>
  </section>

  <!-- SECTORS GRID -->
  <section class="w-full py-16 bg-[#EFF1F5] industrial-grid border-b border-neutral-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sectors.map((s) => (
          <div class={`bg-white rounded-2xl border-t-4 ${s.color} border-x border-b border-neutral-200 p-7 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all flex flex-col justify-between`}>
            <div>
              <span class={`inline-block px-2.5 py-1 rounded-md text-[11px] font-bold border mb-4 ${s.badge}`}>{s.load}</span>
              <h2 class="text-xl font-black text-zinc-950 mb-2">{s.name}</h2>
              <p class="text-sm text-neutral-600 leading-relaxed mb-5">{s.desc}</p>
              <div class="bg-neutral-100 border border-neutral-200 rounded-xl p-3.5 text-xs font-mono text-neutral-700 mb-6">
                <strong>Recommended:</strong> {s.equip}
              </div>
            </div>
            <a href="/contact" class="text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1">
              Get Sector Quote &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
