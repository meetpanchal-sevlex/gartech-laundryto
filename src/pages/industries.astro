---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Industries We Serve | Hotels, Hospitals, Dry Cleaners | Gartech Global" description="Gartech Global provides laundry machinery for hotels, hospitals, dry cleaners, commercial laundries, garment manufacturers and institutions.">

  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="max-w-3xl mb-14">
      <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em] leading-[1.1] mb-4">Industries We Serve</h1>
      <p class="text-lg text-neutral-500 leading-relaxed">Laundry Machinery for Different Industries — from compact commercial setups to large industrial facilities, we provide the right machinery for every professional laundry application.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {[
        {
          title: "Hotels & Resorts",
          icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-blue-500 transition-colors duration-300"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>',
          desc: "Equipment for linen, towels, uniforms and guest garments. Hotels require reliable, high-throughput machinery that handles diverse textiles without compromising quality.",
          items: ["Linen washing and drying", "Towel processing", "Uniform care", "Guest garment finishing", "High-volume throughput"],
        },
        {
          title: "Hospitals",
          icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-rose-500 transition-colors duration-300"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6"/><path d="M12 16v-6"/><path d="M9 13h6"/></svg>',
          desc: "Machinery for institutional textile and linen processing. Healthcare laundry requires machines that can handle high-temperature washing for hygiene compliance.",
          items: ["Bed linen processing", "Patient garment washing", "Staff uniform care", "High-temperature capability", "Large volume throughput"],
        },
        {
          title: "Dry Cleaners",
          icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-cyan-500 transition-colors duration-300"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>',
          desc: "Washing, drying and finishing equipment for professional garment care. Dry cleaners need precision machinery that handles delicate fabrics with care.",
          items: ["Commercial washing machines", "Garment dryers", "Steam press machines", "Finishing equipment", "Customer garment care"],
        },
        {
          title: "Commercial Laundries",
          icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-amber-500 transition-colors duration-300"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/></svg>',
          desc: "Machinery for high-volume customer laundry processing. Commercial laundries need durable, cost-efficient machines built for 24/7 operation.",
          items: ["High-capacity washers", "Industrial dryers", "Garment finishing", "Customer linen processing", "24/7 operation capability"],
        },
        {
          title: "Garment Manufacturers",
          icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-indigo-500 transition-colors duration-300"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" x2="8.12" y1="4" y2="15.88"/><line x1="14.47" x2="20" y1="14.48" y2="20"/><line x1="8.12" x2="12" y1="8.12" y2="12"/></svg>',
          desc: "Machinery supporting garment processing and finishing. Manufacturers need industrial-grade equipment for post-production washing and pressing.",
          items: ["Industrial washing", "Garment finishing", "Steam pressing", "Bulk processing", "Production-line integration"],
        },
        {
          title: "Institutions",
          icon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600 group-hover:text-emerald-500 transition-colors duration-300"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>',
          desc: "Equipment for hostels, schools, factories and large organizations requiring centralized laundry processing for staff uniforms and facility linens.",
          items: ["Uniform washing", "Linen processing", "Hostel laundry", "Factory uniform care", "Centralized laundry operations"],
        },
      ].map(industry => (
        <div class="group bg-white rounded-3xl border border-neutral-200/80 card-shadow hover:card-shadow-hover hover:-translate-y-1 transition-all duration-300 p-8">
          <div class="flex items-start gap-4 mb-5">
            <div class="w-14 h-14 rounded-2xl bg-neutral-50 flex items-center justify-center border border-neutral-200/80 shadow-[0_2px_8px_rgba(0,0,0,0.04)] mb-2" set:html={industry.icon}></div>
            <h2 class="text-xl font-bold tracking-tight pt-1">{industry.title}</h2>
          </div>
          <p class="text-neutral-500 leading-relaxed mb-6">{industry.desc}</p>
          <ul class="space-y-2">
            {industry.items.map(item => (
              <li class="flex items-center gap-2.5 text-sm text-neutral-700">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-950 shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 bg-neutral-50 border border-neutral-200/80 rounded-3xl p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight mb-2">Your industry not listed?</h2>
        <p class="text-neutral-500">Contact us — we work with many businesses that require professional laundry machinery.</p>
      </div>
      <a href="/contact" class="shrink-0 inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-zinc-950 rounded-full hover:bg-zinc-800 transition-all hover:-translate-y-0.5 duration-150">Get in Touch</a>
    </div>
  </section>

</Layout>
