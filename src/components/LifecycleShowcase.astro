---
// Zero-JS-framework, ultra-fast interactive lifecycle carousel in native Astro
const stages = [
  {
    id: "installation",
    step: "01",
    title: "Site Prep & Installation",
    tag: "Turnkey Commissioning",
    color: "blue",
    accent: "text-blue-400",
    bgAccent: "bg-blue-500/10 border-blue-500/30",
    desc: "Precision anchoring, civil foundation verification, steam & water line hookup, and 3-phase electrical MCC integration by factory-trained engineers."
  },
  {
    id: "commissioning",
    step: "02",
    title: "72-Hour Load Calibration",
    tag: "Quality Assurance",
    color: "emerald",
    accent: "text-emerald-400",
    bgAccent: "bg-emerald-500/10 border-emerald-500/30",
    desc: "Full wet-load balance testing, VFD inverter frequency tuning, G-force extraction calibration, and chemical dosing pump synchronization."
  },
  {
    id: "training",
    step: "03",
    title: "Operator Training & SOPs",
    tag: "Skill Transfer",
    color: "amber",
    accent: "text-amber-400",
    bgAccent: "bg-amber-500/10 border-amber-500/30",
    desc: "Hands-on staff training covering cycle selection, stain pre-treatment, lint filter cleaning, and daily safety checklists in Hindi, English, and regional languages."
  },
  {
    id: "maintenance",
    step: "04",
    title: "Preventive AMC & Spares",
    tag: "Zero Downtime",
    color: "indigo",
    accent: "text-indigo-400",
    bgAccent: "bg-indigo-500/10 border-indigo-500/30",
    desc: "Scheduled quarterly preventive inspections and same-day dispatch from our 10,000+ SKU genuine spare parts warehouse in Gujarat."
  }
];
---

<div class="bg-zinc-950 rounded-3xl border border-zinc-800 shadow-2xl p-6 sm:p-10 text-white industrial-grid-dark">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Left Selector Buttons -->
    <div class="lg:col-span-5 space-y-3">
      {stages.map((stage, idx) => (
        <button
          type="button"
          class={`lifecycle-btn w-full text-left p-4 rounded-2xl border transition-all duration-200 flex items-start gap-4 ${idx === 0 ? 'bg-zinc-900 border-blue-500/60 shadow-lg' : 'bg-zinc-900/40 border-zinc-800 hover:bg-zinc-900/80'}`}
          data-stage={idx}
        >
          <span class={`font-mono text-xs font-bold px-2.5 py-1 rounded-lg border ${stage.bgAccent} ${stage.accent} shrink-0`}>
            {stage.step}
          </span>
          <div>
            <p class="font-bold text-sm text-white">{stage.title}</p>
            <p class="text-xs text-neutral-400 mt-0.5">{stage.tag}</p>
          </div>
        </button>
      ))}
    </div>

    <!-- Right Display Panel -->
    <div class="lg:col-span-7 bg-zinc-900/80 border border-zinc-800 rounded-2xl p-8 min-h-[280px] flex flex-col justify-between relative overflow-hidden">
      <div class="absolute top-0 right-0 w-48 h-48 bg-blue-600/10 blur-[60px] rounded-full pointer-events-none"></div>
      
      {stages.map((stage, idx) => (
        <div class={`lifecycle-panel transition-opacity duration-300 ${idx === 0 ? 'block' : 'hidden'}`} data-panel={idx}>
          <div class="flex items-center justify-between mb-6">
            <span class={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold border ${stage.bgAccent} ${stage.accent}`}>
              STAGE {stage.step} &bull; {stage.tag.toUpperCase()}
            </span>
            <span class="text-xs font-mono text-neutral-500">ISO 9001:2015 PROTOCOL</span>
          </div>
          
          <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-white mb-4">
            {stage.title}
          </h3>
          <p class="text-neutral-300 text-sm sm:text-base leading-relaxed mb-8">
            {stage.desc}
          </p>

          <div class="pt-5 border-t border-zinc-800 flex flex-wrap items-center justify-between gap-4 text-xs">
            <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              24-48 Hr On-Site Dispatch Guarantee
            </span>
            <a href="/contact" class="font-bold text-white hover:text-blue-400 transition-colors">
              Book Service Engineer &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>

<script>
  function initLifecycleTabs() {
    const btns = document.querySelectorAll('.lifecycle-btn');
    const panels = document.querySelectorAll('.lifecycle-panel');
    if (!btns.length) return;

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-stage');
        btns.forEach(b => {
          b.classList.remove('bg-zinc-900', 'border-blue-500/60', 'shadow-lg');
          b.classList.add('bg-zinc-900/40', 'border-zinc-800');
        });
        btn.classList.add('bg-zinc-900', 'border-blue-500/60', 'shadow-lg');
        btn.classList.remove('bg-zinc-900/40', 'border-zinc-800');

        panels.forEach(p => {
          if (p.getAttribute('data-panel') === target) {
            p.classList.remove('hidden');
            p.classList.add('block');
          } else {
            p.classList.add('hidden');
            p.classList.remove('block');
          }
        });
      });
    });
  }

  initLifecycleTabs();
  document.addEventListener('astro:page-load', initLifecycleTabs);
</script>
