---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Gartech Global - India's trusted manufacturer & supplier of industrial laundry machinery, commercial washing machines, tumble dryers, steam press, and turnkey laundry setups since 1998." } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#EFF1F5] text-zinc-950 antialiased flex flex-col min-h-screen">

    <!-- HEADER & TOP INDUSTRIAL BAR -->
    <header class="fixed top-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-b border-neutral-200/80 shadow-xs">
      
      <!-- TOP CONTACT & TRUST BAR (Shaikh Petroleum Style) -->
      <div class="hidden lg:block bg-zinc-950 text-neutral-300 text-xs py-2 px-4 sm:px-6 lg:px-8 border-b border-zinc-800">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
          
          <!-- Left: Direct Contact Hotline -->
          <div class="flex items-center gap-6">
            <span class="flex items-center gap-2 font-medium text-white">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Pan-India Sales Hotline:
            </span>
            <a href="tel:+919898029292" class="hover:text-white transition-colors flex items-center gap-1.5 font-semibold text-neutral-200">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +91 98980 29292
            </a>
            <a href="mailto:sales@gartechglobal.com" class="hover:text-white transition-colors flex items-center gap-1.5 text-neutral-400">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              sales@gartechglobal.com
            </a>
            <span class="text-neutral-500 hidden xl:inline">|</span>
            <span class="text-neutral-400 hidden xl:inline">
              Plant: GIDC Industrial Estate, Gujarat &bull; Pan-India Dispatch
            </span>
          </div>

          <!-- Right: Trust Badges & Direct WhatsApp -->
          <div class="flex items-center gap-5">
            <span class="text-neutral-400 font-mono text-[11px]">
              EST. 1998 &bull; 25+ YRS EXCELLENCE
            </span>
            <span class="px-2 py-0.5 rounded-sm bg-zinc-800 text-neutral-300 font-mono text-[10px] tracking-wider uppercase border border-zinc-700">
              ISO 9001:2015
            </span>
            <a href="https://wa.me/919898029292?text=Hello%20Gartech%20Global,%20I%20am%20interested%20in%20industrial%20laundry%20machinery.%20Please%20share%20the%20catalogue%20and%20pricing." target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-semibold flex items-center gap-1 transition-colors">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 2C6.5 2 2.012 6.48 2.012 12c0 2.074.634 4.004 1.722 5.613L2.004 22l4.542-1.685A9.957 9.957 0 0 0 12.031 22c5.522 0 10.012-4.48 10.012-10S17.553 2 12.031 2zm5.795 14.282c-.244.686-1.42 1.312-1.956 1.393-.536.082-1.222.115-1.983-.127-.463-.146-1.058-.344-1.825-.678-3.21-1.393-5.297-4.664-5.457-4.88-.16-.217-1.304-1.737-1.304-3.314s.827-2.353 1.12-2.674c.294-.321.642-.401.856-.401.214 0 .428.002.615.011.198.01.463-.075.723.551.268.643.916 2.234.996 2.396.08.16.134.348.027.562-.107.214-.16.348-.321.536-.16.187-.337.417-.481.56-.16.16-.328.334-.141.654.187.32.83 1.369 1.782 2.218 1.224 1.092 2.256 1.43 2.577 1.59.32.16.508.134.695-.08.188-.215.803-.936 1.017-1.257.214-.321.428-.268.722-.16.294.107 1.872.883 2.193 1.044.321.16.536.241.615.375.08.134.08.776-.164 1.462z"/></svg>
              WhatsApp Support
            </a>
          </div>

        </div>
      </div>

      <!-- MAIN NAVIGATION BAR -->
      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between gap-4">

        <!-- Mobile: Hamburger Menu (Left) -->
        <button id="mobile-menu-btn" class="lg:hidden flex items-center justify-center p-2 -ml-2 text-zinc-950 hover:bg-neutral-100 rounded-lg transition-colors" aria-label="Toggle Navigation">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>

        <!-- Brand Logo -->
        <a href="/" class="font-bold text-xl md:text-2xl tracking-tight shrink-0 flex items-center gap-2.5 md:gap-3 absolute left-1/2 -translate-x-1/2 lg:static lg:translate-x-0">
          <span class="w-8 h-8 md:w-10 md:h-10 bg-zinc-950 rounded-lg md:rounded-xl flex items-center justify-center shadow-sm">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="2" width="5" height="5" rx="1" fill="white"/>
              <rect x="9" y="2" width="5" height="5" rx="1" fill="white" opacity="0.6"/>
              <rect x="2" y="9" width="5" height="5" rx="1" fill="white" opacity="0.6"/>
              <rect x="9" y="9" width="5" height="5" rx="1" fill="white"/>
            </svg>
          </span>
          <div class="flex flex-col">
            <span class="leading-none text-zinc-950 font-extrabold tracking-tight">Gartech Global</span>
            <span class="text-[9px] uppercase tracking-wider text-neutral-400 font-medium hidden sm:block">Industrial Laundry Systems</span>
          </div>
        </a>

        <!-- Mobile: Quick Direct Call Button (Right) -->
        <a href="tel:+919898029292" class="lg:hidden p-2 text-zinc-950 hover:bg-neutral-100 rounded-lg" aria-label="Call Sales">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>

        <!-- Desktop Navigation Items -->
        <div class="hidden lg:flex items-center justify-between flex-1 ml-8">
          <nav class="flex items-center gap-1 xl:gap-2 text-sm font-semibold text-zinc-700">
            
            <!-- Laundry Machinery Dropdown -->
            <div class="relative group">
              <a href="/machinery" class="flex items-center gap-1.5 px-3 py-2 rounded-lg hover:bg-neutral-100 hover:text-zinc-950 transition-all">
                Laundry Machinery
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <div class="absolute top-full left-0 mt-2 w-96 bg-white rounded-2xl shadow-[0_12px_40px_-8px_rgba(0,0,0,0.15)] border border-neutral-200/80 p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0">
                <a href="/machinery/commercial-washing-machines" class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-9 h-9 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center shrink-0 border border-blue-100">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><path d="M12 2v2M12 20v2"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-zinc-950 text-sm">Commercial Washers</p>
                    <p class="text-neutral-500 text-xs">20 KG to 120 KG &middot; High G-Force</p>
                  </div>
                </a>
                <a href="/machinery/commercial-laundry-dryers" class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-9 h-9 bg-amber-50 text-amber-600 rounded-lg flex items-center justify-center shrink-0 border border-amber-100">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="12" cy="12" r="5"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-zinc-950 text-sm">Industrial Tumble Dryers</p>
                    <p class="text-neutral-500 text-xs">15 KG to 100 KG &middot; Reversing Drum</p>
                  </div>
                </a>
                <a href="/machinery/lg-commercial-stackers" class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-9 h-9 bg-indigo-50 text-indigo-600 rounded-lg flex items-center justify-center shrink-0 border border-indigo-100">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M4 12h16"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-zinc-950 text-sm">LG Commercial Stackers</p>
                    <p class="text-neutral-500 text-xs">10 KG &middot; 15 KG &middot; Laundromat Ready</p>
                  </div>
                </a>
                <a href="/machinery/hydra-industrial-laundry-machinery" class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-9 h-9 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center shrink-0 border border-emerald-100">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg>
                  </div>
                  <div>
                    <p class="font-semibold text-zinc-950 text-sm">Hydra Barrier Washers</p>
                    <p class="text-neutral-500 text-xs">60 KG to 215 KG &middot; Cleanroom & Pharma</p>
                  </div>
                </a>
              </div>
            </div>

            <a href="/steam-press-machines" class="px-3 py-2 rounded-lg hover:bg-neutral-100 hover:text-zinc-950 transition-all">Steam Press</a>
            
            <!-- SPECIFICATION & PRICE MATRIX (Shaikh Petroleum Inspired) -->
            <a href="/price-list" class="px-3 py-2 rounded-lg hover:bg-neutral-100 hover:text-zinc-950 transition-all flex items-center gap-1.5 text-blue-600 font-bold">
              <span>Price List & Specs</span>
              <span class="px-1.5 py-0.2 rounded-full bg-blue-100 text-blue-700 text-[10px] uppercase font-bold tracking-wider">Specs</span>
            </a>

            <!-- Single Combined Section for Industries, Setup, Why Us & Contact -->
            <div class="relative group">
              <button class="flex items-center gap-1.5 px-3 py-2 rounded-lg hover:bg-neutral-100 hover:text-zinc-950 transition-all whitespace-nowrap">
                <span>Company &amp; Solutions</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="absolute top-full right-0 xl:left-0 mt-2 w-80 bg-white rounded-2xl shadow-[0_12px_40px_-8px_rgba(0,0,0,0.15)] border border-neutral-200/80 p-2.5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0 z-50">
                
                <a href="/industries" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-8 h-8 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center shrink-0 border border-blue-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5m-4 0h4"/></svg>
                  </div>
                  <div>
                    <p class="font-bold text-zinc-950 text-xs">Industries We Serve</p>
                    <p class="text-neutral-500 text-[11px]">Hotels, Hospitals, Laundromats, Garments</p>
                  </div>
                </a>

                <a href="/setup" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-8 h-8 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center shrink-0 border border-emerald-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                  </div>
                  <div>
                    <p class="font-bold text-zinc-950 text-xs">Turnkey Laundry Setup</p>
                    <p class="text-neutral-500 text-[11px]">Facility Planning, Sizing &amp; CAD Layouts</p>
                  </div>
                </a>

                <a href="/why-us" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-8 h-8 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center shrink-0 border border-purple-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  </div>
                  <div>
                    <p class="font-bold text-zinc-950 text-xs">Why Choose Gartech</p>
                    <p class="text-neutral-500 text-[11px]">25+ Yrs Legacy, 10,000+ Ready Spares</p>
                  </div>
                </a>

                <a href="/contact" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-neutral-50 transition-colors">
                  <div class="w-8 h-8 bg-amber-50 text-amber-600 rounded-lg flex items-center justify-center shrink-0 border border-amber-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  </div>
                  <div>
                    <p class="font-bold text-zinc-950 text-xs">Contact &amp; Works</p>
                    <p class="text-neutral-500 text-[11px]">Gujarat Plant, Depots &amp; Hotline</p>
                  </div>
                </a>

              </div>
            </div>
          </nav>

          <!-- Right Action CTAs -->
          <div class="flex items-center gap-3">
            <a href="/contact#catalogue" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full border border-neutral-300 text-xs font-semibold text-zinc-800 hover:bg-neutral-50 transition-all">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              Brochure (PDF)
            </a>
            <a href="/contact" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-zinc-950 text-white text-xs font-bold hover:bg-zinc-800 transition-all active:scale-95 shadow-sm">
              Request Quote
            </a>
          </div>

        </div>

      </div>

      <!-- MOBILE SLIDE-OUT DRAWER -->
      <div id="mobile-menu" class="lg:hidden fixed inset-x-0 top-16 bg-white border-b border-neutral-200 shadow-xl transition-all duration-300 transform -translate-y-full opacity-0 pointer-events-none max-h-[calc(100vh-4rem)] overflow-y-auto">
        <div class="p-6 space-y-6">

          <!-- Mobile Direct Actions -->
          <div class="grid grid-cols-2 gap-3">
            <a href="tel:+919898029292" class="flex items-center justify-center gap-2 p-3 rounded-xl bg-zinc-950 text-white text-xs font-bold text-center">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call Sales
            </a>
            <a href="https://wa.me/919898029292?text=Hello%20Gartech%20Global,%20I%20am%20interested%20in%20industrial%20laundry%20machinery." target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 p-3 rounded-xl bg-emerald-600 text-white text-xs font-bold text-center">
              WhatsApp
            </a>
          </div>

          <!-- Feature Nav Item -->
          <a href="/price-list" class="flex items-center justify-between p-3.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-900 font-bold text-sm">
            <div class="flex items-center gap-2.5">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/></svg>
              <span>Price List & Specifications</span>
            </div>
            <span class="text-xs bg-blue-600 text-white px-2 py-0.5 rounded-full font-bold">VIEW</span>
          </a>

          <!-- Standard Links -->
          <div class="space-y-1 text-sm font-semibold text-zinc-800">
            <p class="text-[11px] uppercase tracking-wider text-neutral-400 font-bold px-3 py-1">Machinery Catalog</p>
            <a href="/machinery" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">All Laundry Machinery</a>
            <a href="/machinery/commercial-washing-machines" class="block px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600">&bull; Commercial Washing Machines</a>
            <a href="/machinery/commercial-laundry-dryers" class="block px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600">&bull; Industrial Tumble Dryers</a>
            <a href="/machinery/lg-commercial-stackers" class="block px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600">&bull; LG Commercial Stackers</a>
            <a href="/machinery/hydra-industrial-laundry-machinery" class="block px-3 py-2 rounded-lg hover:bg-neutral-100 text-neutral-600">&bull; Hydra Barrier Washers</a>
            
            <p class="text-[11px] uppercase tracking-wider text-neutral-400 font-bold px-3 py-1 mt-4">Finishing & Solutions</p>
            <a href="/steam-press-machines" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">Steam Press Machines</a>
            <a href="/garment-finishing" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">Garment Finishing Equipment</a>
            <a href="/setup" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">Commercial Laundry Setup</a>
            <a href="/industries" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">Industries We Serve</a>
            <a href="/why-us" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">Why Choose Gartech</a>
            <a href="/service-support" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">Service & Spares Support</a>
            <a href="/about" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">About Company</a>
            <a href="/contact" class="block px-3 py-2 rounded-lg hover:bg-neutral-100">Contact & Plant Locations</a>
          </div>

          <div class="pt-4 border-t border-neutral-200">
            <p class="text-xs text-neutral-500 mb-2">Plant: GIDC Industrial Estate, Gujarat</p>
            <p class="text-xs text-neutral-500">Sales: sales@gartechglobal.com</p>
          </div>

        </div>
      </div>

    </header>

    <!-- CONTENT WRAPPER (Accounts for fixed header height) -->
    <main class="flex-1 pt-16 lg:pt-28">
      <slot />
